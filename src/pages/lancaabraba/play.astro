---
import AnalyticsConsent from '../../components/AnalyticsConsent.astro';
import LabAlphaFeedback from '../../components/LabAlphaFeedback.astro';
import LabAlphaLocalization from '../../components/LabAlphaLocalization.astro';
import LabConsentLocalization from '../../components/LabConsentLocalization.astro';
import { labAlphaBundleRevision } from '../../data/lab-alpha-bundle';
import '../../styles/global.css';

const gameUrl = '/lancaabraba/play/game/';
const feedbackAccessKey = 'cf7d8e77-011b-43f4-9be4-efc4a7d3c9ff';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050b16" />
    <meta name="description" content="Public prototype of Lança a Braba by Realeiros Play." />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href="https://realeirosplay.com/lancaabraba/play/" />
    <link rel="icon" href="/favicon.ico" />
    <title>Lança a Braba — Public Alpha | Realeiros Play</title>
  </head>
  <body class="lab-play-shell" data-lab-bundle={labAlphaBundleRevision} data-lab-surface="menu">
    <iframe
      class="lab-game-frame"
      data-lab-game-frame
      src={gameUrl}
      title="Lança a Braba — Public Alpha"
      allow="autoplay; fullscreen"
      loading="eager"
    ></iframe>

    <LabAlphaFeedback accessKey={feedbackAccessKey} />
    <LabAlphaLocalization />
    <AnalyticsConsent />
    <LabConsentLocalization />

    <script is:inline>
      (() => {
        const frame = document.querySelector('[data-lab-game-frame]');
        if (frame instanceof HTMLIFrameElement) {
          const params = new URLSearchParams(window.location.search);
          if (params.get('telemetry') === '1') {
            frame.src = '/lancaabraba/play/game/?telemetry=1';
          }
        }

        // hCaptcha injects its challenge iframe at document level. A native
        // dialog opened with showModal() enters the browser top layer, which
        // always wins over normal z-index and leaves the captcha challenge
        // visually behind the feedback form. Keep the semantic <dialog>, but
        // open this one as non-modal so hCaptcha can stack above it normally.
        const feedbackDialog = document.querySelector('[data-lab-feedback-dialog]');
        if (feedbackDialog instanceof HTMLDialogElement) {
          feedbackDialog.setAttribute('aria-modal', 'true');
          feedbackDialog.showModal = () => {
            if (!feedbackDialog.open) feedbackDialog.show();
          };
        }

        const feedbackButton = document.querySelector('[data-lab-feedback-open]');
        const feedbackGateNote = document.querySelector('[data-feedback-gate-note]');

        const setFeedbackSurface = (surface) => {
          const allowFeedback = surface !== 'gameplay';
          document.body.dataset.labSurface = surface;

          if (feedbackButton instanceof HTMLButtonElement) {
            feedbackButton.hidden = !allowFeedback;
            feedbackButton.disabled = !allowFeedback;
            feedbackButton.setAttribute('aria-hidden', allowFeedback ? 'false' : 'true');
          }

          if (!allowFeedback) {
            if (feedbackGateNote instanceof HTMLElement) feedbackGateNote.hidden = true;
            if (feedbackDialog instanceof HTMLDialogElement && feedbackDialog.open) {
              feedbackDialog.close();
            }
          }
        };

        // The game iframe reports only the coarse UI surface (`menu` or
        // `gameplay`). This keeps the feedback shell independent from React
        // routing while guaranteeing that the floating CTA never competes with
        // SNAP, routes or throw gestures during an active drive.
        window.addEventListener('message', (event) => {
          if (event.origin !== window.location.origin) return;
          if (!(frame instanceof HTMLIFrameElement) || event.source !== frame.contentWindow) return;

          const data = event.data;
          if (!data || typeof data !== 'object') return;
          if (data.source !== 'lanca-a-braba' || data.type !== 'lab_game_surface') return;
          if (data.surface !== 'menu' && data.surface !== 'gameplay') return;

          setFeedbackSurface(data.surface);
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html,
  body.lab-play-shell {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    background: #050b16;
  }

  body.lab-play-shell {
    position: fixed;
    inset: 0;
  }

  .lab-game-frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100dvh;
    border: 0;
    background: #050b16;
  }

  /*
   * `hidden` must win over the feedback component's responsive display rules.
   * The body surface selector is a second independent guard so the CTA can
   * never remain in the mobile gameplay stacking context underneath/above SNAP.
   */
  .lab-feedback-trigger[hidden],
  body.lab-play-shell[data-lab-surface='gameplay'] .lab-feedback-trigger,
  body.lab-play-shell[data-lab-surface='gameplay'] .lab-feedback-gate-note {
    display: none !important;
    visibility: hidden !important;
    pointer-events: none !important;
  }

  /*
   * The LAB feedback dialog intentionally stays out of the browser top layer.
   * hCaptcha uses a document-level challenge overlay with a very high z-index;
   * keeping this dialog in the normal stacking context lets that challenge sit
   * above the form instead of being trapped underneath a modal <dialog>.
   */
  .lab-feedback-dialog[open] {
    position: fixed !important;
    inset: 0 !important;
    z-index: 2147483620 !important;
    box-shadow:
      0 0 0 100vmax rgba(2, 6, 14, .78),
      0 30px 90px rgba(0, 0, 0, .72),
      0 0 40px rgba(245, 230, 27, .12) !important;
  }

  .analytics-consent {
    z-index: 2147483647;
  }
</style>
