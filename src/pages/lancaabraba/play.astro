---
import AnalyticsConsent from '../../components/AnalyticsConsent.astro';
import { labAlphaBundleRevision } from '../../data/lab-alpha-bundle';
import '../../styles/global.css';

const gameUrl = '/lancaabraba/play/game/';
const feedbackAccessKey = '2ed9e4fa-0579-40d2-b44d-2f5f67790fad';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050b16" />
    <meta name="description" content="Protótipo público do Lança a Braba, da Realeiros Play." />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href="https://realeirosplay.com/lancaabraba/play/" />
    <link rel="icon" href="/favicon.ico" />
    <title>Lança a Braba — Public Alpha | Realeiros Play</title>
  </head>
  <body class="lab-play-shell" data-lab-bundle={labAlphaBundleRevision}>
    <iframe
      class="lab-game-frame"
      data-lab-game-frame
      src={gameUrl}
      title="Lança a Braba — Public Alpha"
      allow="autoplay; fullscreen"
      loading="eager"
    ></iframe>

    <button class="lab-feedback-trigger" type="button" data-lab-feedback-open aria-haspopup="dialog">
      <span class="lab-feedback-trigger-icon" aria-hidden="true">★</span>
      <span>Enviar feedback</span>
    </button>

    <dialog class="lab-feedback-dialog" data-lab-feedback-dialog aria-labelledby="lab-feedback-title">
      <div class="lab-feedback-panel">
        <div class="lab-feedback-header">
          <div>
            <p class="lab-feedback-kicker">PUBLIC ALPHA</p>
            <h1 id="lab-feedback-title">Ajude a melhorar o Lança a Braba</h1>
            <p>Leva cerca de 1 minuto. Seu feedback entra diretamente na avaliação desta alpha.</p>
          </div>
          <button class="lab-feedback-close" type="button" data-lab-feedback-close aria-label="Fechar feedback">×</button>
        </div>

        <form class="lab-feedback-form" data-lab-feedback-form>
          <input type="hidden" name="access_key" value={feedbackAccessKey} />
          <input type="hidden" name="subject" value="Feedback Public Alpha - Lança a Braba" />
          <input type="hidden" name="from_name" value="Lança a Braba - Public Alpha" />
          <input type="hidden" name="produto" value="Lança a Braba" />
          <input type="hidden" name="fase" value="Public Alpha" />
          <input type="hidden" name="alpha_version" value="0.1.0-alpha.1" />
          <input type="hidden" name="viewport" data-feedback-viewport />
          <input type="hidden" name="touch_capable" data-feedback-touch />
          <input type="hidden" name="platform" data-feedback-platform />

          <div class="lab-feedback-botcheck" aria-hidden="true">
            <label>Não preencha este campo <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
          </div>

          <fieldset class="lab-feedback-field lab-star-field" data-star-rating>
            <legend>Quanto você se divertiu?</legend>
            <p class="lab-feedback-hint">1 = nada divertido · 5 = muito divertido</p>
            <div class="lab-stars" role="radiogroup" aria-label="Nota de diversão de 1 a 5 estrelas">
              <input class="lab-star-input" type="radio" id="fun-1" name="fun_rating" value="1" required />
              <label class="lab-star" for="fun-1" data-star-value="1" aria-label="1 estrela">★</label>
              <input class="lab-star-input" type="radio" id="fun-2" name="fun_rating" value="2" />
              <label class="lab-star" for="fun-2" data-star-value="2" aria-label="2 estrelas">★</label>
              <input class="lab-star-input" type="radio" id="fun-3" name="fun_rating" value="3" />
              <label class="lab-star" for="fun-3" data-star-value="3" aria-label="3 estrelas">★</label>
              <input class="lab-star-input" type="radio" id="fun-4" name="fun_rating" value="4" />
              <label class="lab-star" for="fun-4" data-star-value="4" aria-label="4 estrelas">★</label>
              <input class="lab-star-input" type="radio" id="fun-5" name="fun_rating" value="5" />
              <label class="lab-star" for="fun-5" data-star-value="5" aria-label="5 estrelas">★</label>
            </div>
          </fieldset>

          <fieldset class="lab-feedback-field lab-star-field" data-star-rating>
            <legend>Foi fácil entender como jogar?</legend>
            <p class="lab-feedback-hint">1 = muito confuso · 5 = muito claro</p>
            <div class="lab-stars" role="radiogroup" aria-label="Nota de clareza de 1 a 5 estrelas">
              <input class="lab-star-input" type="radio" id="clarity-1" name="clarity_rating" value="1" required />
              <label class="lab-star" for="clarity-1" data-star-value="1" aria-label="1 estrela">★</label>
              <input class="lab-star-input" type="radio" id="clarity-2" name="clarity_rating" value="2" />
              <label class="lab-star" for="clarity-2" data-star-value="2" aria-label="2 estrelas">★</label>
              <input class="lab-star-input" type="radio" id="clarity-3" name="clarity_rating" value="3" />
              <label class="lab-star" for="clarity-3" data-star-value="3" aria-label="3 estrelas">★</label>
              <input class="lab-star-input" type="radio" id="clarity-4" name="clarity_rating" value="4" />
              <label class="lab-star" for="clarity-4" data-star-value="4" aria-label="4 estrelas">★</label>
              <input class="lab-star-input" type="radio" id="clarity-5" name="clarity_rating" value="5" />
              <label class="lab-star" for="clarity-5" data-star-value="5" aria-label="5 estrelas">★</label>
            </div>
          </fieldset>

          <fieldset class="lab-feedback-field">
            <legend>Como você achou a dificuldade?</legend>
            <div class="lab-choice-row">
              <label><input type="radio" name="difficulty" value="facil" required /><span>Fácil</span></label>
              <label><input type="radio" name="difficulty" value="equilibrada" /><span>Equilibrada</span></label>
              <label><input type="radio" name="difficulty" value="dificil" /><span>Difícil</span></label>
            </div>
          </fieldset>

          <fieldset class="lab-feedback-field">
            <legend>Você jogaria novamente?</legend>
            <div class="lab-choice-row">
              <label><input type="radio" name="replay_intent" value="sim" required /><span>Sim</span></label>
              <label><input type="radio" name="replay_intent" value="talvez" /><span>Talvez</span></label>
              <label><input type="radio" name="replay_intent" value="nao" /><span>Não</span></label>
            </div>
          </fieldset>

          <label class="lab-feedback-field">
            <span>O que você mais gostou? <small>(opcional)</small></span>
            <textarea name="liked_most" rows="3" maxlength="1000" placeholder="Pode ser uma mecânica, sensação, visual, som ou qualquer outro ponto."></textarea>
          </label>

          <label class="lab-feedback-field">
            <span>O que mais te incomodou ou confundiu? <small>(opcional)</small></span>
            <textarea name="friction" rows="3" maxlength="1000" placeholder="Conte onde você travou, ficou em dúvida ou sentiu alguma frustração."></textarea>
          </label>

          <fieldset class="lab-feedback-field">
            <legend>Encontrou algum bug?</legend>
            <div class="lab-choice-row lab-choice-row-short">
              <label><input type="radio" name="bug_reported" value="sim" required data-bug-answer /><span>Sim</span></label>
              <label><input type="radio" name="bug_reported" value="nao" data-bug-answer /><span>Não</span></label>
            </div>
          </fieldset>

          <label class="lab-feedback-field lab-bug-details" data-bug-details hidden>
            <span>Descreva o bug <small>(opcional)</small></span>
            <textarea name="bug_details" rows="3" maxlength="1200" placeholder="O que aconteceu e, se souber, como reproduzir?"></textarea>
          </label>

          <div class="lab-feedback-identity">
            <label class="lab-feedback-field">
              <span>Nome <small>(opcional)</small></span>
              <input type="text" name="name" maxlength="100" autocomplete="name" />
            </label>
            <label class="lab-feedback-field">
              <span>E-mail <small>(opcional)</small></span>
              <input type="email" name="email" maxlength="180" autocomplete="email" />
            </label>
          </div>

          <p class="lab-feedback-privacy">Nome e e-mail são opcionais. Se informados, serão usados apenas para eventual contato sobre este feedback. Consulte a <a href="/privacidade" target="_blank" rel="noreferrer">Política de Privacidade</a>.</p>

          <div class="lab-feedback-actions">
            <button class="lab-feedback-submit" type="submit" data-feedback-submit>
              <span data-feedback-submit-label>Enviar feedback</span>
            </button>
            <p class="lab-feedback-status" role="status" aria-live="polite" data-feedback-status></p>
          </div>
        </form>
      </div>
    </dialog>

    <AnalyticsConsent />

    <script is:inline>
      (() => {
        const frame = document.querySelector('[data-lab-game-frame]');
        const dialog = document.querySelector('[data-lab-feedback-dialog]');
        const openButton = document.querySelector('[data-lab-feedback-open]');
        const closeButton = document.querySelector('[data-lab-feedback-close]');
        const form = document.querySelector('[data-lab-feedback-form]');

        if (frame instanceof HTMLIFrameElement) {
          const params = new URLSearchParams(window.location.search);
          if (params.get('telemetry') === '1') {
            frame.src = '/lancaabraba/play/game/?telemetry=1';
          }
        }

        if (
          !(dialog instanceof HTMLDialogElement) ||
          !(openButton instanceof HTMLButtonElement) ||
          !(closeButton instanceof HTMLButtonElement) ||
          !(form instanceof HTMLFormElement)
        ) return;

        const submitButton = form.querySelector('[data-feedback-submit]');
        const submitLabel = form.querySelector('[data-feedback-submit-label]');
        const status = form.querySelector('[data-feedback-status]');
        const viewportInput = form.querySelector('[data-feedback-viewport]');
        const touchInput = form.querySelector('[data-feedback-touch]');
        const platformInput = form.querySelector('[data-feedback-platform]');
        const bugDetails = form.querySelector('[data-bug-details]');

        let feedbackStarted = false;

        const analytics = (name, extra = {}) => {
          if (window.__realeirosGa4Loaded !== true || typeof window.gtag !== 'function') return;
          window.gtag('event', name, {
            page_path: window.location.pathname,
            product: 'lanca_a_braba',
            phase: 'public_alpha',
            ...extra,
          });
        };

        const setMetadata = () => {
          if (viewportInput instanceof HTMLInputElement) viewportInput.value = `${window.innerWidth}x${window.innerHeight}`;
          if (touchInput instanceof HTMLInputElement) touchInput.value = navigator.maxTouchPoints > 0 ? 'sim' : 'nao';
          if (platformInput instanceof HTMLInputElement) platformInput.value = navigator.userAgentData?.platform || navigator.platform || 'unknown';
        };

        const setStatus = (message, state = '') => {
          if (!(status instanceof HTMLElement)) return;
          status.textContent = message;
          if (state) status.dataset.state = state;
          else delete status.dataset.state;
        };

        const resetStarVisuals = () => {
          form.querySelectorAll('[data-star-rating]').forEach((group) => {
            group.querySelectorAll('[data-star-value]').forEach((star) => star.classList.remove('is-active'));
          });
        };

        form.querySelectorAll('[data-star-rating]').forEach((group) => {
          const inputs = Array.from(group.querySelectorAll('input[type="radio"]'));
          const stars = Array.from(group.querySelectorAll('[data-star-value]'));

          const selectedValue = () => {
            const selected = inputs.find((input) => input instanceof HTMLInputElement && input.checked);
            return selected instanceof HTMLInputElement ? Number(selected.value) : 0;
          };

          const paint = (value) => {
            stars.forEach((star) => {
              const starValue = Number(star.getAttribute('data-star-value') || 0);
              star.classList.toggle('is-active', starValue <= value);
            });
          };

          inputs.forEach((input) => input.addEventListener('change', () => paint(selectedValue())));
          stars.forEach((star) => {
            star.addEventListener('mouseenter', () => paint(Number(star.getAttribute('data-star-value') || 0)));
            star.addEventListener('focusin', () => paint(Number(star.getAttribute('data-star-value') || 0)));
          });
          group.addEventListener('mouseleave', () => paint(selectedValue()));
          group.addEventListener('focusout', (event) => {
            if (!group.contains(event.relatedTarget)) paint(selectedValue());
          });
        });

        form.querySelectorAll('[data-bug-answer]').forEach((input) => {
          input.addEventListener('change', () => {
            if (!(bugDetails instanceof HTMLElement)) return;
            const selected = form.querySelector('input[name="bug_reported"]:checked');
            bugDetails.hidden = !(selected instanceof HTMLInputElement && selected.value === 'sim');
          });
        });

        const markStarted = () => {
          if (feedbackStarted) return;
          feedbackStarted = true;
          analytics('lab_feedback_start');
        };

        openButton.addEventListener('click', () => {
          feedbackStarted = false;
          setMetadata();
          setStatus('');
          analytics('lab_feedback_open');
          dialog.showModal();
        });

        closeButton.addEventListener('click', () => dialog.close());
        dialog.addEventListener('click', (event) => {
          if (event.target === dialog) dialog.close();
        });
        form.addEventListener('focusin', markStarted);
        form.addEventListener('change', markStarted);

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          markStarted();
          setMetadata();

          if (!(submitButton instanceof HTMLButtonElement) || !(submitLabel instanceof HTMLElement)) return;

          submitButton.disabled = true;
          submitLabel.textContent = 'Enviando...';
          setStatus('Enviando seu feedback...');

          const data = new FormData(form);
          const payload = Object.fromEntries(data.entries());

          try {
            const response = await fetch('https://api.web3forms.com/submit', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
              body: JSON.stringify(payload),
            });
            const result = await response.json().catch(() => null);
            if (!response.ok || result?.success !== true) throw new Error(result?.message || `HTTP ${response.status}`);

            analytics('lab_feedback_submit', {
              fun_rating: Number(data.get('fun_rating') || 0),
              clarity_rating: Number(data.get('clarity_rating') || 0),
              difficulty: String(data.get('difficulty') || ''),
              replay_intent: String(data.get('replay_intent') || ''),
              bug_reported: String(data.get('bug_reported') || ''),
            });

            form.reset();
            resetStarVisuals();
            if (bugDetails instanceof HTMLElement) bugDetails.hidden = true;
            setStatus('Feedback enviado. Obrigado por participar da Public Alpha!', 'success');
          } catch (error) {
            analytics('lab_feedback_error', { error_type: error instanceof TypeError ? 'network' : 'provider' });
            setStatus('Não foi possível enviar agora. Tente novamente em alguns instantes.', 'error');
          } finally {
            submitButton.disabled = false;
            submitLabel.textContent = 'Enviar feedback';
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  html,
  body.lab-play-shell {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    background: #050b16;
  }

  body.lab-play-shell {
    position: fixed;
    inset: 0;
  }

  .lab-game-frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100dvh;
    border: 0;
    background: #050b16;
  }

  .lab-feedback-trigger {
    position: fixed;
    right: max(14px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 2147483600;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 46px;
    padding: 0 17px;
    overflow: hidden;
    border: 1px solid rgba(255, 237, 77, .95);
    border-radius: 999px;
    background: linear-gradient(135deg, #f5e61b 0%, #ffd84a 52%, #f5e61b 100%);
    color: #07101f;
    font: 900 13px/1 system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    letter-spacing: .01em;
    cursor: pointer;
    box-shadow:
      0 0 0 1px rgba(245, 230, 27, .18),
      0 0 18px rgba(245, 230, 27, .68),
      0 7px 26px rgba(0, 0, 0, .42);
    animation: lab-feedback-pulse 2.3s ease-in-out infinite;
    transition: transform .18s ease, box-shadow .18s ease;
  }

  .lab-feedback-trigger::after {
    content: "";
    position: absolute;
    z-index: -1;
    top: -95%;
    left: -48%;
    width: 22%;
    height: 290%;
    transform: rotate(18deg);
    background: linear-gradient(90deg, transparent, rgba(255,255,255,.98), transparent);
    filter: blur(1px);
    animation: lab-feedback-sweep 2.8s ease-in-out infinite;
    pointer-events: none;
  }

  .lab-feedback-trigger:hover,
  .lab-feedback-trigger:focus-visible {
    transform: translateY(-2px) scale(1.025);
    outline: none;
    box-shadow:
      0 0 0 3px rgba(245, 230, 27, .22),
      0 0 28px rgba(245, 230, 27, .92),
      0 9px 30px rgba(0, 0, 0, .5);
  }

  .lab-feedback-trigger-icon {
    font-size: 17px;
    line-height: 1;
  }

  @keyframes lab-feedback-pulse {
    0%, 100% { box-shadow: 0 0 0 1px rgba(245,230,27,.18), 0 0 15px rgba(245,230,27,.5), 0 7px 26px rgba(0,0,0,.42); }
    50% { box-shadow: 0 0 0 4px rgba(245,230,27,.11), 0 0 30px rgba(245,230,27,.88), 0 7px 28px rgba(0,0,0,.46); }
  }

  @keyframes lab-feedback-sweep {
    0%, 18% { left: -48%; opacity: 0; }
    28% { opacity: 1; }
    68% { opacity: 1; }
    82%, 100% { left: 132%; opacity: 0; }
  }

  .lab-feedback-dialog {
    width: min(680px, calc(100vw - 24px));
    max-height: min(88dvh, 820px);
    margin: auto;
    padding: 0;
    overflow: hidden;
    border: 1px solid rgba(245,230,27,.38);
    border-radius: 22px;
    background: #081226;
    color: #f5f0e6;
    box-shadow: 0 30px 90px rgba(0,0,0,.72), 0 0 40px rgba(245,230,27,.12);
  }

  .lab-feedback-dialog::backdrop {
    background: rgba(2, 6, 14, .78);
    backdrop-filter: blur(6px);
  }

  .lab-feedback-panel {
    max-height: min(88dvh, 820px);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .lab-feedback-header {
    position: sticky;
    top: 0;
    z-index: 3;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 22px 22px 18px;
    border-bottom: 1px solid rgba(255,255,255,.09);
    background: rgba(8,18,38,.96);
    backdrop-filter: blur(12px);
  }

  .lab-feedback-header h1 {
    margin: 3px 0 7px;
    color: #fff;
    font: 900 clamp(22px, 5vw, 30px)/1.05 system-ui, sans-serif;
  }

  .lab-feedback-header p:not(.lab-feedback-kicker) {
    margin: 0;
    color: #aebbd0;
    font: 500 13px/1.45 system-ui, sans-serif;
  }

  .lab-feedback-kicker {
    margin: 0;
    color: #f5e61b;
    font: 900 10px/1 system-ui, sans-serif;
    letter-spacing: .16em;
  }

  .lab-feedback-close {
    flex: 0 0 38px;
    width: 38px;
    height: 38px;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 50%;
    background: rgba(255,255,255,.06);
    color: #fff;
    font: 300 27px/1 system-ui, sans-serif;
    cursor: pointer;
  }

  .lab-feedback-form {
    display: grid;
    gap: 18px;
    padding: 22px;
  }

  .lab-feedback-field {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    border: 0;
    color: #f5f0e6;
    font: 700 14px/1.35 system-ui, sans-serif;
  }

  .lab-feedback-field legend,
  .lab-feedback-field > span {
    padding: 0;
    color: #f5f0e6;
    font: 800 14px/1.35 system-ui, sans-serif;
  }

  .lab-feedback-field small {
    color: #8797b1;
    font-weight: 600;
  }

  .lab-feedback-hint {
    margin: -3px 0 0;
    color: #8392aa;
    font: 500 11px/1.35 system-ui, sans-serif;
  }

  .lab-stars {
    display: flex;
    align-items: center;
    gap: clamp(7px, 2.4vw, 13px);
    width: fit-content;
  }

  .lab-star-input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .lab-star {
    color: #34435c;
    font-size: clamp(34px, 9vw, 46px);
    line-height: 1;
    cursor: pointer;
    filter: drop-shadow(0 2px 3px rgba(0,0,0,.35));
    transform-origin: center;
    transition: color .12s ease, transform .12s ease, filter .12s ease;
  }

  .lab-star.is-active {
    color: #f5e61b;
    transform: translateY(-1px) scale(1.06);
    filter: drop-shadow(0 0 8px rgba(245,230,27,.52));
  }

  .lab-star-input:focus-visible + .lab-star {
    outline: 2px solid #fff;
    outline-offset: 4px;
    border-radius: 4px;
  }

  .lab-choice-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .lab-choice-row-short {
    grid-template-columns: repeat(2, minmax(0, 140px));
  }

  .lab-choice-row label {
    position: relative;
    display: block;
    cursor: pointer;
  }

  .lab-choice-row input {
    position: absolute;
    opacity: 0;
  }

  .lab-choice-row span {
    display: grid;
    place-items: center;
    min-height: 42px;
    padding: 0 10px;
    border: 1px solid rgba(255,255,255,.13);
    border-radius: 11px;
    background: rgba(255,255,255,.045);
    color: #c9d3e1;
    font: 800 12px/1 system-ui, sans-serif;
    transition: .14s ease;
  }

  .lab-choice-row input:checked + span {
    border-color: #f5e61b;
    background: rgba(245,230,27,.13);
    color: #fff7a6;
    box-shadow: 0 0 14px rgba(245,230,27,.12);
  }

  .lab-choice-row input:focus-visible + span {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .lab-feedback-field textarea,
  .lab-feedback-field input[type="text"],
  .lab-feedback-field input[type="email"] {
    width: 100%;
    box-sizing: border-box;
    border: 1px solid rgba(255,255,255,.14);
    border-radius: 11px;
    background: #050b16;
    color: #f5f0e6;
    font: 500 13px/1.45 system-ui, sans-serif;
    outline: none;
  }

  .lab-feedback-field textarea {
    min-height: 82px;
    padding: 11px 12px;
    resize: vertical;
  }

  .lab-feedback-field input[type="text"],
  .lab-feedback-field input[type="email"] {
    height: 42px;
    padding: 0 12px;
  }

  .lab-feedback-field textarea:focus,
  .lab-feedback-field input[type="text"]:focus,
  .lab-feedback-field input[type="email"]:focus {
    border-color: rgba(245,230,27,.8);
    box-shadow: 0 0 0 3px rgba(245,230,27,.09);
  }

  .lab-feedback-identity {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
