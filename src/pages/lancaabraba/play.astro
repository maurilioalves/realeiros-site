---
import AnalyticsConsent from '../../components/AnalyticsConsent.astro';
import '../../styles/global.css';

const gameUrl = '/lancaabraba/play/game/';
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#050b16" />
    <meta name="description" content="Protótipo público do Lança a Braba, da Realeiros Play." />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="canonical" href="https://realeirosplay.com/lancaabraba/play/" />
    <link rel="icon" href="/favicon.ico" />
    <title>Lança a Braba — Public Alpha | Realeiros Play</title>
  </head>
  <body class="lab-play-shell">
    <iframe
      class="lab-game-frame"
      src={gameUrl}
      title="Lança a Braba — Public Alpha"
      allow="autoplay; fullscreen"
      loading="eager"
    ></iframe>
    <AnalyticsConsent />
  </body>
</html>

<style is:global>
  html,
  body.lab-play-shell {
    margin: 0;
    width: 100%;
    height: 100%;
    min-height: 100%;
    overflow: hidden;
    overscroll-behavior: none;
    background: #050b16;
  }

  body.lab-play-shell {
    position: fixed;
    inset: 0;
  }

  .lab-game-frame {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100dvh;
    border: 0;
    background: #050b16;
  }

  .analytics-consent {
    z-index: 2147483647;
  }
</style>
