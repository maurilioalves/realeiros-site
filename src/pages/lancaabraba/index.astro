---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { localizePath, type RouteLocale } from '../../i18n/config';

interface Props { locale?: RouteLocale; }
const { locale = 'pt-BR' } = Astro.props;
const href = (path: string) => localizePath(path, locale);
const copy = {
  'pt-BR': {
    description: 'Lança a Braba é o arcade de futebol americano da Realeiros Play: jogue como quarterback, encare partidas rápidas, evolua e complete desafios direto no navegador.',
    eyebrow: 'Arcade de futebol americano • Web • Public Alpha',
    titleTop: 'Lê a defesa.', titleAccent: 'Lança a braba.',
    lead: 'Um arcade de sessões curtas centrado na habilidade do quarterback. Escolha a jogada, encontre o recebedor e coloque a bola onde a defesa não consegue chegar.',
    play: 'Jogar agora', understand: 'Como funciona', identity: 'Lança a Braba — um jogo da Realeiros Play', iconAlt: 'Ícone oficial do Lança a Braba',
    badges: ['Jogue no navegador','Desktop e mobile','PT-BR • EN-US • ES-ES'],
    whyEyebrow: 'O que é Lança a Braba', whyTitle: 'Fácil de começar. Difícil de dominar.', whyText: 'A partida coloca o jogador no papel do QB e transforma leitura, timing e precisão em decisões rápidas. O loop foi pensado para caber entre atividades e ainda dar vontade de tentar de novo.',
    features: [
      ['🏈','Você é o QB','Leia a defesa, escolha a rota certa e faça o passe. O foco está na execução, não em controlar onze jogadores ao mesmo tempo.'],
      ['🎯','Passe com habilidade','Timing, direção e força importam. Cada jogada pede uma leitura diferente do espaço e da cobertura.'],
      ['⏱️','Sessões curtas','Partidas rápidas para jogar em poucos minutos, com modos acelerados e desafios que favorecem uma tentativa a mais.'],
      ['🏆','Temporada Relâmpago','Uma campanha compacta para transformar partidas isoladas em uma sequência com objetivo e consequência.'],
      ['🔥','Desafios recorrentes','Daily Challenge e Two Minute Drill criam objetivos diferentes para voltar ao jogo.'],
      ['🎨','Perfil e personalização','Progresso, REP, créditos e cosméticos dão continuidade à experiência sem mudar o núcleo de habilidade do gameplay.'],
    ],
    loopEyebrow: 'Loop do produto', loopTitle: 'Joga. Melhora. Volta.', loopText: 'O core foi construído para transformar uma ação simples — lançar a bola — em um ciclo de domínio, progressão e repetição.',
    loop: [['01','Jogar','Entre numa partida ou desafio.'],['02','Melhorar','Aprenda leitura, timing e precisão.'],['03','Progredir','Acumule progresso, REP e recompensas.'],['04','Personalizar','Use créditos e cosméticos no seu perfil.'],['05','Voltar','Tente outra campanha, desafio ou pontuação.']],
    browserEyebrow: 'Disponível agora', browserTitle: 'Sem instalar. Abre e joga.', browserText: 'A Public Alpha roda direto no navegador e já conta com Perfil/Save, progressão, cosméticos, Temporada Relâmpago, desafios diários, tutorial, três idiomas e telemetria para orientar a evolução do produto.',
    alphaTitle: 'Public Alpha', alphaText: 'Esta é uma versão pública em evolução. Conteúdo, balanceamento, economia e apresentação podem mudar entre atualizações. Feedback pode ser enviado dentro da própria experiência.',
    platformLabel: 'Plataforma', platformValue: 'Web', statusLabel: 'Status', statusValue: 'Public Alpha', languageLabel: 'Idiomas', languageValue: 'PT-BR · EN-US · ES-ES', studioLabel: 'Desenvolvedor', studioValue: 'Realeiros Play',
    finalEyebrow: 'Pronto para a próxima jogada?', finalTitle: 'Escolhe a rota e solta o braço.', finalText: 'Lança a Braba está jogável agora no navegador.', finalPlay: 'Jogar Lança a Braba', more: 'Conhecer a Realeiros',
  },
  en: {
    description: 'Lança a Braba is Realeiros Play’s arcade American football game: play as the quarterback, take on quick matches, progress and complete challenges directly in your browser.',
    eyebrow: 'Arcade American football • Web • Public Alpha',
    titleTop: 'Read the defense.', titleAccent: 'Let it fly.',
    lead: 'A short-session arcade game centered on quarterback skill. Pick the play, find the receiver and put the ball where the defense cannot reach it.',
    play: 'Play now', understand: 'How it works', identity: 'Lança a Braba — a game by Realeiros Play', iconAlt: 'Official Lança a Braba icon',
    badges: ['Play in your browser','Desktop and mobile','PT-BR • EN-US • ES-ES'],
    whyEyebrow: 'What is Lança a Braba', whyTitle: 'Easy to start. Hard to master.', whyText: 'Each match puts you in the quarterback role and turns reads, timing and accuracy into quick decisions. The loop is designed to fit between activities and still make one more attempt tempting.',
    features: [
      ['🏈','You are the QB','Read the defense, choose the right route and make the throw. The focus is execution, not controlling eleven players at once.'],
      ['🎯','Skill-based passing','Timing, direction and power matter. Every play asks you to read space and coverage differently.'],
      ['⏱️','Short sessions','Quick matches built for a few minutes at a time, with faster modes and challenges that encourage another attempt.'],
      ['🏆','Lightning Season','A compact campaign that turns isolated matches into a sequence with goals and consequences.'],
      ['🔥','Recurring challenges','Daily Challenge and Two Minute Drill create different reasons to return.'],
      ['🎨','Profile and customization','Progress, REP, credits and cosmetics add continuity without changing the skill-focused core of the gameplay.'],
    ],
    loopEyebrow: 'Product loop', loopTitle: 'Play. Improve. Return.', loopText: 'The core turns one simple action — throwing the ball — into a cycle of mastery, progression and replayability.',
    loop: [['01','Play','Enter a match or challenge.'],['02','Improve','Learn reads, timing and accuracy.'],['03','Progress','Build progress, REP and rewards.'],['04','Customize','Use credits and cosmetics on your profile.'],['05','Return','Try another campaign, challenge or score.']],
    browserEyebrow: 'Available now', browserTitle: 'No install. Open and play.', browserText: 'The Public Alpha runs directly in the browser and already includes Profile/Save, progression, cosmetics, Lightning Season, daily challenges, tutorial, three languages and telemetry to guide product evolution.',
    alphaTitle: 'Public Alpha', alphaText: 'This is a public version in active development. Content, balance, economy and presentation may change between updates. Feedback can be sent from inside the experience.',
    platformLabel: 'Platform', platformValue: 'Web', statusLabel: 'Status', statusValue: 'Public Alpha', languageLabel: 'Languages', languageValue: 'PT-BR · EN-US · ES-ES', studioLabel: 'Developer', studioValue: 'Realeiros Play',
    finalEyebrow: 'Ready for the next play?', finalTitle: 'Pick the route and let it fly.', finalText: 'Lança a Braba is playable now in your browser.', finalPlay: 'Play Lança a Braba', more: 'About Realeiros',
  },
  es: {
    description: 'Lança a Braba es el arcade de fútbol americano de Realeiros Play: juega como quarterback, disputa partidos rápidos, progresa y completa desafíos directamente en tu navegador.',
    eyebrow: 'Arcade de fútbol americano • Web • Public Alpha',
    titleTop: 'Lee la defensa.', titleAccent: 'Lanza la bomba.',
    lead: 'Un arcade de sesiones cortas centrado en la habilidad del quarterback. Elige la jugada, encuentra al receptor y coloca el balón donde la defensa no pueda llegar.',
    play: 'Jugar ahora', understand: 'Cómo funciona', identity: 'Lança a Braba — un juego de Realeiros Play', iconAlt: 'Icono oficial de Lança a Braba',
    badges: ['Juega en el navegador','Desktop y móvil','PT-BR • EN-US • ES-ES'],
    whyEyebrow: 'Qué es Lança a Braba', whyTitle: 'Fácil de empezar. Difícil de dominar.', whyText: 'Cada partido te pone en el papel del quarterback y convierte lectura, timing y precisión en decisiones rápidas. El loop está pensado para encajar entre actividades y aun así invitar a intentarlo una vez más.',
    features: [
      ['🏈','Tú eres el QB','Lee la defensa, elige la ruta correcta y ejecuta el pase. El foco está en la ejecución, no en controlar once jugadores a la vez.'],
      ['🎯','Pase basado en habilidad','Timing, dirección y fuerza importan. Cada jugada exige una lectura diferente del espacio y la cobertura.'],
      ['⏱️','Sesiones cortas','Partidos rápidos para jugar en pocos minutos, con modos acelerados y desafíos que favorecen otro intento.'],
      ['🏆','Temporada Relámpago','Una campaña compacta que convierte partidos aislados en una secuencia con objetivos y consecuencias.'],
      ['🔥','Desafíos recurrentes','Daily Challenge y Two Minute Drill crean motivos diferentes para volver.'],
      ['🎨','Perfil y personalización','Progreso, REP, créditos y cosméticos aportan continuidad sin cambiar el núcleo de habilidad del gameplay.'],
    ],
    loopEyebrow: 'Loop del producto', loopTitle: 'Juega. Mejora. Vuelve.', loopText: 'El núcleo transforma una acción sencilla — lanzar el balón — en un ciclo de dominio, progresión y repetición.',
    loop: [['01','Jugar','Entra en un partido o desafío.'],['02','Mejorar','Aprende lectura, timing y precisión.'],['03','Progresar','Acumula progreso, REP y recompensas.'],['04','Personalizar','Usa créditos y cosméticos en tu perfil.'],['05','Volver','Prueba otra campaña, desafío o puntuación.']],
    browserEyebrow: 'Disponible ahora', browserTitle: 'Sin instalar. Abre y juega.', browserText: 'La Public Alpha funciona directamente en el navegador e incluye Perfil/Save, progresión, cosméticos, Temporada Relámpago, desafíos diarios, tutorial, tres idiomas y telemetría para orientar la evolución del producto.',
    alphaTitle: 'Public Alpha', alphaText: 'Esta es una versión pública en evolución. El contenido, balance, economía y presentación pueden cambiar entre actualizaciones. El feedback puede enviarse desde la propia experiencia.',
    platformLabel: 'Plataforma', platformValue: 'Web', statusLabel: 'Estado', statusValue: 'Public Alpha', languageLabel: 'Idiomas', languageValue: 'PT-BR · EN-US · ES-ES', studioLabel: 'Desarrollador', studioValue: 'Realeiros Play',
    finalEyebrow: '¿Listo para la siguiente jugada?', finalTitle: 'Elige la ruta y suelta el brazo.', finalText: 'Lança a Braba ya se puede jugar en el navegador.', finalPlay: 'Jugar Lança a Braba', more: 'Conocer Realeiros',
  },
}[locale];
---

<BaseLayout
  title="Lança a Braba"
  description={copy.description}
  image="/lancaabraba/play/game/lanca-a-braba-icon.webp"
  locale={locale}
  localizedAlternates
>
  <section class="lab-hero">
    <div class="container lab-hero-grid">
      <div class="lab-hero-copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <div class="lab-brand-row"><img src="/lancaabraba/play/game/lanca-a-braba-icon.webp" alt={copy.iconAlt} width="132" height="132" /><div><strong>Lança a Braba</strong><span>{copy.identity}</span></div></div>
        <h1>{copy.titleTop}<br /><span>{copy.titleAccent}</span></h1>
        <p class="lead">{copy.lead}</p>
        <div class="hero-actions"><a class="button button-primary" href="/lancaabraba/play/">{copy.play}</a><a class="button button-secondary" href="#gameplay">{copy.understand}</a></div>
        <div class="lab-badges">{copy.badges.map((badge) => <span>{badge}</span>)}</div>
      </div>
      <div class="lab-field" aria-hidden="true">
        <div class="lab-score"><span>Q4</span><strong>02:00</strong></div>
        <div class="yard yard-1"></div><div class="yard yard-2"></div><div class="yard yard-3"></div><div class="yard yard-4"></div>
        <span class="player qb">QB</span><span class="player wr-a">WR</span><span class="player wr-b">WR</span><span class="defender d-a"></span><span class="defender d-b"></span><span class="defender d-c"></span>
        <div class="throw-line"></div><div class="ball">◆</div>
      </div>
    </div>
  </section>

  <section id="gameplay" class="section section-paper">
    <div class="container"><SectionHeading eyebrow={copy.whyEyebrow} title={copy.whyTitle} text={copy.whyText} />
      <div class="feature-grid lab-feature-grid">{copy.features.map(([icon,title,text]) => <article class="feature-box"><div class="icon">{icon}</div><h3>{title}</h3><p>{text}</p></article>)}</div>
    </div>
  </section>

  <section class="section lab-loop-section">
    <div class="container"><SectionHeading eyebrow={copy.loopEyebrow} title={copy.loopTitle} text={copy.loopText} />
      <div class="lab-loop">{copy.loop.map(([number,title,text]) => <article><span>{number}</span><h3>{title}</h3><p>{text}</p></article>)}</div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="container lab-browser-grid">
      <div><p class="eyebrow">{copy.browserEyebrow}</p><h2>{copy.browserTitle}</h2><p>{copy.browserText}</p><a class="button button-primary" href="/lancaabraba/play/">{copy.play}</a></div>
      <div class="lab-facts">
        <dl><div><dt>{copy.platformLabel}</dt><dd>{copy.platformValue}</dd></div><div><dt>{copy.statusLabel}</dt><dd>{copy.statusValue}</dd></div><div><dt>{copy.languageLabel}</dt><dd>{copy.languageValue}</dd></div><div><dt>{copy.studioLabel}</dt><dd>{copy.studioValue}</dd></div></dl>
        <aside><strong>{copy.alphaTitle}</strong><p>{copy.alphaText}</p></aside>
      </div>
    </div>
  </section>

  <section class="section"><div class="container cta-panel"><div><p class="eyebrow">{copy.finalEyebrow}</p><h2>{copy.finalTitle}</h2><p>{copy.finalText}</p></div><div class="cta-panel-actions"><a class="button button-primary" href="/lancaabraba/play/">{copy.finalPlay}</a><a class="button button-secondary" href={href('/sobre')}>{copy.more}</a></div></div></section>
</BaseLayout>

<style>
  .lab-hero { padding:clamp(54px,8vw,104px) 0; color:#fff; background:radial-gradient(circle at 76% 28%,rgba(245,230,27,.12),transparent 27%),linear-gradient(145deg,#081226,#102844 58%,#081226); overflow:hidden; }
  .lab-hero-grid { display:grid; grid-template-columns:minmax(0,1.05fr) minmax(330px,.95fr); gap:54px; align-items:center; }
  .lab-brand-row { display:flex; align-items:center; gap:18px; margin:22px 0; }
  .lab-brand-row img { width:92px; height:92px; border-radius:23px; box-shadow:0 16px 36px rgba(0,0,0,.35); }
  .lab-brand-row strong { display:block; font-family:Anton,sans-serif; font-size:1.8rem; letter-spacing:.02em; }
  .lab-brand-row span { display:block; margin-top:4px; color:#a9bad5; font-size:.86rem; font-weight:700; }
  .lab-hero h1 { margin:.3rem 0 1rem; font-size:clamp(3.1rem,7vw,6.4rem); line-height:.92; }
  .lab-hero h1 span { color:#f5e61b; }
  .lab-hero .lead { max-width:720px; color:#d7e1f3; }
  .lab-badges { display:flex; flex-wrap:wrap; gap:8px; margin-top:22px; }
  .lab-badges span { padding:7px 10px; border:1px solid rgba(255,255,255,.16); border-radius:999px; background:rgba(255,255,255,.05); color:#d7e1f3; font-size:.8rem; font-weight:800; }
  .lab-field { position:relative; min-height:490px; overflow:hidden; border:1px solid rgba(255,255,255,.14); border-radius:34px; background:linear-gradient(180deg,#183b55,#102d45); box-shadow:0 28px 70px rgba(0,0,0,.32),inset 0 0 80px rgba(0,0,0,.22); transform:perspective(900px) rotateY(-5deg) rotateX(2deg); }
  .lab-field::before,.lab-field::after { content:''; position:absolute; left:7%; right:7%; height:2px; background:rgba(255,255,255,.18); } .lab-field::before{top:18%;}.lab-field::after{bottom:18%;}
  .yard { position:absolute; top:0; bottom:0; width:1px; background:rgba(255,255,255,.12); }.yard-1{left:20%;}.yard-2{left:40%;}.yard-3{left:60%;}.yard-4{left:80%;}
  .lab-score { position:absolute; top:22px; left:22px; display:flex; align-items:center; gap:9px; padding:8px 12px; border-radius:10px; background:#081226; box-shadow:0 8px 20px rgba(0,0,0,.25); }.lab-score span{color:#93a5c5;font-size:.74rem;font-weight:800}.lab-score strong{font-variant-numeric:tabular-nums;}
  .player { position:absolute; display:grid; place-items:center; width:48px; height:48px; border-radius:50%; background:#f5e61b; color:#081226; font-size:.72rem; font-weight:900; box-shadow:0 0 0 6px rgba(245,230,27,.09); }.qb{left:17%;bottom:24%;}.wr-a{right:17%;top:25%;background:#fff}.wr-b{right:21%;bottom:20%;background:#fff}
  .defender { position:absolute; width:31px; height:31px; border-radius:50%; background:#e34d5b; box-shadow:0 0 0 5px rgba(227,77,91,.09); }.d-a{left:51%;top:28%;}.d-b{left:59%;top:52%;}.d-c{left:47%;bottom:20%;}
  .throw-line { position:absolute; left:25%; bottom:31%; width:60%; height:3px; background:#f5e61b; transform:rotate(-29deg); transform-origin:left center; box-shadow:0 0 16px rgba(245,230,27,.55); }.throw-line::after{content:'➤';position:absolute;right:-8px;top:-12px;color:#f5e61b;font-size:22px;}
  .ball { position:absolute; left:61%; top:38%; color:#f5e61b; font-size:18px; transform:rotate(18deg); }
  .lab-feature-grid .feature-box { min-height:230px; }
  .lab-loop-section { background:#081226; color:#fff; }.lab-loop-section :global(.section-heading p){color:#b7c5db;}
  .lab-loop { display:grid; grid-template-columns:repeat(5,1fr); gap:12px; }.lab-loop article { padding:22px; border:1px solid rgba(255,255,255,.12); border-radius:18px; background:rgba(255,255,255,.045); }.lab-loop article > span { color:#f5e61b; font-family:Anton,sans-serif; font-size:1.5rem; }.lab-loop h3 { margin:.5rem 0; }.lab-loop p { color:#b7c5db; font-size:.92rem; }
  .lab-browser-grid { display:grid; grid-template-columns:minmax(0,1fr) minmax(320px,.8fr); gap:54px; align-items:start; }.lab-browser-grid h2{font-size:clamp(2.2rem,4vw,4rem);}.lab-browser-grid > div:first-child > p:not(.eyebrow){max-width:720px;}
  .lab-facts { display:grid; gap:16px; }.lab-facts dl { margin:0; border:1px solid #d9e0e9; border-radius:20px; background:#fff; overflow:hidden; }.lab-facts dl div{display:flex;justify-content:space-between;gap:20px;padding:15px 18px;border-bottom:1px solid #e8edf3}.lab-facts dl div:last-child{border-bottom:0}.lab-facts dt{font-weight:700;color:#66748a}.lab-facts dd{margin:0;font-weight:900;text-align:right}.lab-facts aside{padding:20px;border-radius:20px;background:#081226;color:#fff}.lab-facts aside strong{color:#f5e61b}.lab-facts aside p{margin-bottom:0;color:#c3cfe0}
  @media (max-width:900px){.lab-hero-grid,.lab-browser-grid{grid-template-columns:1fr}.lab-field{min-height:360px;transform:none}.lab-loop{grid-template-columns:repeat(2,1fr)}}
  @media (max-width:560px){.lab-loop{grid-template-columns:1fr}.lab-brand-row img{width:76px;height:76px}.lab-field{min-height:300px}.lab-hero h1{font-size:clamp(2.8rem,15vw,4.4rem)}}
</style>
