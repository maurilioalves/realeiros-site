---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { localizePath, type RouteLocale } from '../i18n/config';
import ptCopy from '../i18n/privacy-pt';
import enCopy from '../i18n/privacy-en';
import esCopy from '../i18n/privacy-es';

interface Props { locale?: RouteLocale; }
const { locale = 'pt-BR' } = Astro.props;
const href = (path: string) => localizePath(path, locale);
const copy = locale === 'en' ? enCopy : locale === 'es' ? esCopy : ptCopy;
const adPolicyCopy = {
  'pt-BR': {
    updated: 'Última atualização: 18/09/2026',
    version: 'Versão 2.5',
    scope: 'Esta política também se aplica à experiência web do Lança a Braba e às operações oficiais de comunidade da Realeiros Play, incluindo o Realeiros Community Radar, além dos recursos de analytics, publicidade e consentimento usados nessas experiências.',
    community: {
      title: 'Redes sociais e gerenciamento de comunidade',
      paragraphs: [
        'A Realeiros Play pode utilizar integrações oficiais disponibilizadas por plataformas como Instagram/Meta, YouTube/Google, Google Play e Apple App Store para centralizar comentários, avaliações e respostas relacionados aos nossos jogos e canais oficiais.',
        'Nessas operações, poderemos tratar dados fornecidos pela própria plataforma, como nome de usuário ou nome exibido, identificador da interação, conteúdo de comentários, avaliações ou respostas, nota quando aplicável, data e hora, plataforma de origem, publicação ou mídia relacionada e informações sobre o status da resposta.',
        'Esses dados são utilizados para atendimento e relacionamento com a comunidade, organização e deduplicação das interações, moderação, elaboração e publicação de respostas, classificação de feedback, identificação de problemas recorrentes, análise agregada de tendências e melhoria dos produtos e serviços da Realeiros Play.',
        'Ferramentas automatizadas podem auxiliar na classificação de interações, agrupamento de feedback e elaboração de respostas sugeridas. Para essa finalidade, o Community Radar pode enviar à API da OpenAI dados mínimos da interação, como plataforma, contexto da publicação, nota quando aplicável, comentário, idioma, país/território e versão do aplicativo. O nome de usuário não é necessário para a triagem e não é enviado intencionalmente nesse fluxo. A publicação de respostas segue a configuração operacional adotada pela Realeiros Play e pode incluir revisão ou aprovação humana antes do envio.',
        'O Community Radar não utiliza senhas de usuários das redes sociais e acessa apenas os dados disponibilizados pelas APIs e permissões concedidas às contas oficiais da Realeiros Play. Mensagens privadas não fazem parte do escopo atual do Community Radar.',
        'Registros operacionais podem ser armazenados em infraestrutura utilizada pela Realeiros Play, incluindo serviços do Google para automação e planilhas. A exclusão de uma interação diretamente na plataforma de origem pode não remover imediatamente uma cópia operacional já coletada; solicitações de exclusão ou exercício de direitos podem ser realizadas pelos canais indicados nesta política.'
      ]
    },
    metaProvider: 'Privacidade da Meta / Instagram',
    openaiProvider: 'Política de Privacidade da OpenAI',
    siteAdvertising: 'O site institucional realeirosplay.com não possui sistema próprio de criação de conta ou login. As páginas institucionais não exibem publicidade própria, mas a experiência web do Lança a Braba pode utilizar Google AdSense / H5 Games Ads quando esse recurso estiver habilitado.',
    cmp: 'Para visitantes no Espaço Econômico Europeu (EEE), Reino Unido e Suíça, a gestão de consentimento relacionada à publicidade é realizada por uma plataforma de gestão de consentimento (CMP) certificada pelo Google e compatível com o IAB Transparency & Consent Framework (TCF). A disponibilidade e a personalização de anúncios dependem das escolhas do usuário, da legislação aplicável e das configurações do serviço. A preferência de analytics do site permanece um controle separado.',
    adsProvider: 'Tecnologias de publicidade do Google',
  },
  en: {
    updated: 'Last updated: September 18, 2026',
    version: 'Version 2.5',
    scope: 'This policy also applies to the Lança a Braba web experience and Realeiros Play official community operations, including the Realeiros Community Radar, as well as the analytics, advertising and consent resources used in these experiences.',
    community: {
      title: 'Social networks and community management',
      paragraphs: [
        'Realeiros Play may use official integrations provided by platforms such as Instagram/Meta, YouTube/Google, Google Play and Apple App Store to centralize comments, reviews and replies related to our games and official channels.',
        'For these operations, we may process data supplied by the platform itself, such as username or display name, interaction identifier, comment, review or reply content, rating when applicable, date and time, source platform, related post or media and information about reply status.',
        'This data is used for community support and engagement, organization and deduplication of interactions, moderation, drafting and publishing replies, feedback classification, identification of recurring issues, aggregated trend analysis and improvement of Realeiros Play products and services.',
        'Automated tools may assist with interaction classification, feedback grouping and suggested reply drafting. For this purpose, Community Radar may send minimum interaction data to the OpenAI API, such as platform, post context, rating when applicable, comment, language, country/territory and app version. Username is not required for triage and is not intentionally sent in this flow. Reply publication follows the operational configuration adopted by Realeiros Play and may include human review or approval before sending.',
        'Community Radar does not use social-network user passwords and only accesses data made available through APIs and permissions granted to Realeiros Play official accounts. Private messages are not part of the current Community Radar scope.',
        'Operational records may be stored in infrastructure used by Realeiros Play, including Google services for automation and spreadsheets. Deleting an interaction directly on the source platform may not immediately remove an operational copy already collected; deletion requests or exercise of rights may be submitted through the channels described in this policy.'
      ]
    },
    metaProvider: 'Meta / Instagram Privacy',
    openaiProvider: 'OpenAI Privacy Policy',
    siteAdvertising: 'The realeirosplay.com institutional website does not have its own account or login system. Institutional pages do not display their own advertising, but the Lança a Braba web experience may use Google AdSense / H5 Games Ads when that feature is enabled.',
    cmp: 'For visitors in the European Economic Area (EEA), the United Kingdom and Switzerland, advertising consent is managed through a Google-certified consent management platform (CMP) compatible with the IAB Transparency & Consent Framework (TCF). Ad availability and personalization depend on the user’s choices, applicable law and service settings. The website analytics preference remains a separate control.',
    adsProvider: 'Google advertising technologies',
  },
  es: {
    updated: 'Última actualización: 18/09/2026',
    version: 'Versión 2.5',
    scope: 'Esta política también se aplica a la experiencia web de Lança a Braba y a las operaciones oficiales de comunidad de Realeiros Play, incluido Realeiros Community Radar, además de los recursos de analítica, publicidad y consentimiento utilizados en estas experiencias.',
    community: {
      title: 'Redes sociales y gestión de comunidad',
      paragraphs: [
        'Realeiros Play puede utilizar integraciones oficiales proporcionadas por plataformas como Instagram/Meta, YouTube/Google, Google Play y Apple App Store para centralizar comentarios, reseñas y respuestas relacionadas con nuestros juegos y canales oficiales.',
        'En estas operaciones podremos tratar datos proporcionados por la propia plataforma, como nombre de usuario o nombre mostrado, identificador de la interacción, contenido de comentarios, reseñas o respuestas, puntuación cuando corresponda, fecha y hora, plataforma de origen, publicación o contenido relacionado e información sobre el estado de la respuesta.',
        'Estos datos se utilizan para atención y relación con la comunidad, organización y deduplicación de interacciones, moderación, elaboración y publicación de respuestas, clasificación de feedback, identificación de problemas recurrentes, análisis agregado de tendencias y mejora de los productos y servicios de Realeiros Play.',
        'Las herramientas automatizadas pueden ayudar con la clasificación de interacciones, agrupación de feedback y elaboración de respuestas sugeridas. Para esta finalidad, Community Radar puede enviar a la API de OpenAI datos mínimos de la interacción, como plataforma, contexto de la publicación, puntuación cuando corresponda, comentario, idioma, país/territorio y versión de la aplicación. El nombre de usuario no es necesario para la clasificación y no se envía intencionadamente en este flujo. La publicación de respuestas sigue la configuración operativa adoptada por Realeiros Play y puede incluir revisión o aprobación humana antes del envío.',
        'Community Radar no utiliza contraseñas de usuarios de redes sociales y solo accede a los datos disponibles mediante las APIs y los permisos concedidos a las cuentas oficiales de Realeiros Play. Los mensajes privados no forman parte del alcance actual de Community Radar.',
        'Los registros operativos pueden almacenarse en infraestructura utilizada por Realeiros Play, incluidos servicios de Google para automatización y hojas de cálculo. Eliminar una interacción directamente en la plataforma de origen puede no eliminar inmediatamente una copia operativa ya recopilada; las solicitudes de eliminación o ejercicio de derechos pueden realizarse mediante los canales indicados en esta política.'
      ]
    },
    metaProvider: 'Privacidad de Meta / Instagram',
    openaiProvider: 'Política de Privacidad de OpenAI',
    siteAdvertising: 'El sitio institucional realeirosplay.com no cuenta con un sistema propio de creación de cuentas o inicio de sesión. Las páginas institucionales no muestran publicidad propia, pero la experiencia web de Lança a Braba puede utilizar Google AdSense / H5 Games Ads cuando esta función esté habilitada.',
    cmp: 'Para visitantes del Espacio Económico Europeo (EEE), Reino Unido y Suiza, el consentimiento relacionado con publicidad se gestiona mediante una plataforma de gestión de consentimiento (CMP) certificada por Google y compatible con el IAB Transparency & Consent Framework (TCF). La disponibilidad y personalización de anuncios dependen de las decisiones del usuario, la legislación aplicable y la configuración del servicio. La preferencia de analítica del sitio permanece como un control independiente.',
    adsProvider: 'Tecnologías publicitarias de Google',
  },
}[locale];
const providerUrls = [
  'https://firebase.google.com/support/privacy',
  'https://unity.com/legal/privacy-policy',
  'https://policies.google.com/privacy',
  'https://www.apple.com/legal/privacy/',
  'https://privacycenter.instagram.com/policy/',
  'https://openai.com/policies/privacy-policy/',
  'https://policies.google.com/technologies/ads',
];
const providerLinks = [...copy.providerLinks, adPolicyCopy.metaProvider, adPolicyCopy.openaiProvider, adPolicyCopy.adsProvider];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} localizedAlternates>
  <PageHero eyebrow="Legal" title={copy.title} text={copy.hero} />
  <section class="section"><div class="container prose">
    <div class="legal-meta"><span>{adPolicyCopy.updated}</span><span>•</span><span>{adPolicyCopy.version}</span></div>
    <p>{copy.intro[0]}</p>
    <p>{copy.intro[1]} <a href={`${href('/contato')}?tipo=privacy#formulario`}>{copy.contactForm}</a>. <strong>{site.email}</strong>.</p>
    <p>{adPolicyCopy.scope}</p>

    {copy.sections.map((section,index) => <>
      <h2>{section.title}</h2>
      {section.paragraphs?.map((text, paragraphIndex) => index === 8 && paragraphIndex === 0 ? <p>{adPolicyCopy.siteAdvertising}</p> : <p>{text}</p>)}
      {section.list && <ul>{section.list.map((item) => <li>{item}</li>)}</ul>}
      {section.after?.map((text) => <p>{text}</p>)}
      {index === 6 && <>
        <h2>{adPolicyCopy.community.title}</h2>
        {adPolicyCopy.community.paragraphs.map((text) => <p>{text}</p>)}
      </>}
      {index === 7 && <p>{providerLinks.map((label,providerIndex) => <><a href={providerUrls[providerIndex]} target="_blank" rel="noopener noreferrer">{label}</a>{providerIndex < providerLinks.length - 1 ? ' · ' : ''}</>)}</p>}
      {index === 8 && <>
        <p>{adPolicyCopy.cmp}</p>
        <p><button class="button button-secondary button-small" type="button" data-analytics-reset>{copy.reset}</button></p>
      </>}
      {index === 12 && <p><a href={href('/exclusao-de-dados')}>{copy.deletion}</a> · <a href={`${href('/contato')}?tipo=privacy#formulario`}>{copy.contactForm}</a></p>}
      {index === 13 && <p><a href={`${href('/contato')}?tipo=privacy#formulario`}>{copy.contactForm}</a> · <strong>{site.email}</strong></p>}
      {index === 16 && <p><a href={`${href('/contato')}?tipo=privacy#formulario`}>{copy.contactForm}</a><br /><strong>Realeiros Play</strong><br />{site.email}</p>}
    </>)}
  </div></section>
</BaseLayout>
