---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { localizePath, type RouteLocale } from '../i18n/config';

interface Props { locale?: RouteLocale; }
const { locale = 'pt-BR' } = Astro.props;
const href = (path: string) => localizePath(path, locale);
const copy = {
  'pt-BR': {
    description: 'Olha a Batida: Pênaltis é o jogo mobile de futebol da Realeiros Play, com temporadas, clubes da América do Sul e Europa, copas nacionais, torneios continentais e Mundial de Clubes no Android e iOS.', eyebrow: 'Atualização Europa disponível • Android e iOS', intro: 'Escolha seu clube, dispute temporadas completas e decida os grandes jogos nos pênaltis. A nova expansão leva o Olha a Batida para ligas e torneios europeus sem deixar de lado as competições sul-americanas.', heroAlt: 'Recurso gráfico oficial da atualização Europa do Olha a Batida',
    whyEyebrow: 'Nova fase do jogo', whyTitle: 'Da América do Sul à Europa.', whyText: 'O pênalti continua sendo o momento decisivo, agora dentro de uma estrutura de temporadas ainda maior, com ligas, copas e torneios continentais em diferentes regiões.',
    features: [['⚽','Pênaltis que decidem','Cobre, defenda e lide com a pressão de partidas resolvidas nos detalhes.'],['🌍','Europa e América do Sul','Jogue com clubes das principais ligas de Inglaterra, Espanha, Alemanha, Itália e França, além do futebol sul-americano.'],['📅','Temporadas completas','Avance rodada a rodada, acompanhe resultados, classificações e construa campanhas que atravessam toda a temporada.'],['🏆','Grandes torneios','Dispute copas nacionais, Libertadores, Champions OAB, Europa OAB e o Mundial de Clubes dentro da sua campanha.'],['🎨','Personalização','Edite jogadores e represente o seu time dentro da identidade visual do jogo.'],['🎁','Progressão','Recompensas, missões e sistemas recorrentes dão motivo para voltar e continuar evoluindo.']],
    insideEyebrow: 'Atualização Europa', insideTitle: 'Uma temporada maior. Novos caminhos até a taça.', insideText: 'Confira as capturas oficiais da versão atual do Olha a Batida, com conteúdo localizado para cada idioma.', screenshotAlt: 'Screenshot do Olha a Batida',
    faqEyebrow: 'Perguntas frequentes', faqTitle: 'Antes de entrar em campo.', faq: [['O Olha a Batida é gratuito?','Sim. O jogo pode ser baixado gratuitamente e utiliza anúncios para apoiar o desenvolvimento.'],['Em quais plataformas está disponível?','Atualmente, o Olha a Batida está publicado para Android e iOS.'],['O jogo é uma simulação 11x11?','Não. A proposta é outra: concentrar a emoção do futebol nos momentos decisivos, com pênaltis como core gameplay e competições/temporadas como contexto.'],['O Olha a Batida continuará recebendo novidades?','Sim. O jogo continua em evolução com melhorias, conteúdo e novas experiências. A Realeiros anuncia novidades específicas quando cada frente está próxima de chegar aos jogadores.']], faqHelpQ: 'Preciso de ajuda com o jogo?', faqHelpA: 'Acesse a página de', support: 'suporte', or: 'ou abra o', contact: 'formulário de contato',
    finalEyebrow: 'Já diria o poeta', finalTitle: 'AGORA EU SE CONSAGRO!', finalText: 'Baixe no celular e entre no jogo.',
  },
  en: {
    description: 'Olha a Batida: Pênaltis is Realeiros Play’s mobile football game, with seasons, South American and European clubs, domestic cups, continental tournaments and a Club World Cup on Android and iOS.', eyebrow: 'Europe update available • Android and iOS', intro: 'Choose your club, play complete seasons and decide the biggest matches from the penalty spot. The new expansion brings European leagues and tournaments to Olha a Batida while keeping its South American competitions.', heroAlt: 'Official artwork for the Olha a Batida Europe update',
    whyEyebrow: 'A new stage', whyTitle: 'From South America to Europe.', whyText: 'Penalties remain the decisive moment, now inside a larger season structure with leagues, cups and continental tournaments across different regions.',
    features: [['⚽','Decisive penalties','Take shots, make saves and handle the pressure of matches decided by details.'],['🌍','Europe and South America','Play with clubs from the leading leagues in England, Spain, Germany, Italy and France alongside South American football.'],['📅','Complete seasons','Advance round by round, follow results and standings, and build campaigns across a full season.'],['🏆','Major tournaments','Play domestic cups, Libertadores, Champions OAB, Europa OAB and the Club World Cup as part of your campaign.'],['🎨','Customization','Edit players and represent your team within the game’s visual identity.'],['🎁','Progression','Rewards, missions and recurring systems give you reasons to return and keep improving.']],
    insideEyebrow: 'Europe update', insideTitle: 'A bigger season. New paths to the trophy.', insideText: 'See official screenshots from the current Olha a Batida release, localized for each language.', screenshotAlt: 'Olha a Batida screenshot',
    faqEyebrow: 'FAQ', faqTitle: 'Before you step onto the pitch.', faq: [['Is Olha a Batida free?','Yes. The game can be downloaded for free and uses ads to support development.'],['Which platforms is it available on?','Olha a Batida is currently published for Android and iOS.'],['Is it an 11v11 simulation?','No. The goal is different: concentrate football’s emotion in decisive moments, using penalties as the core gameplay and competitions/seasons as context.'],['Will Olha a Batida keep receiving updates?','Yes. The game continues to evolve with improvements, content and new experiences. Realeiros announces specific updates when each initiative is close to reaching players.']], faqHelpQ: 'Need help with the game?', faqHelpA: 'Visit the', support: 'support page', or: 'or open the', contact: 'contact form',
    finalEyebrow: 'Time for the big moment', finalTitle: 'MAKE YOUR MOMENT COUNT!', finalText: 'Download it on your phone and get into the game.',
  },
  es: {
    description: 'Olha a Batida: Pênaltis es el juego móvil de fútbol de Realeiros Play, con temporadas, clubes de Sudamérica y Europa, copas nacionales, torneos continentales y Mundial de Clubes en Android e iOS.', eyebrow: 'Actualización Europa disponible • Android e iOS', intro: 'Elige tu club, disputa temporadas completas y decide los grandes partidos desde el punto de penalti. La nueva expansión lleva ligas y torneos europeos a Olha a Batida sin dejar atrás las competiciones sudamericanas.', heroAlt: 'Recurso gráfico oficial de la actualización Europa de Olha a Batida',
    whyEyebrow: 'Nueva etapa', whyTitle: 'De Sudamérica a Europa.', whyText: 'El penalti sigue siendo el momento decisivo, ahora dentro de una estructura de temporadas más amplia, con ligas, copas y torneos continentales en distintas regiones.',
    features: [['⚽','Penaltis decisivos','Lanza, para y afronta la presión de partidos resueltos por pequeños detalles.'],['🌍','Europa y Sudamérica','Juega con clubes de las principales ligas de Inglaterra, España, Alemania, Italia y Francia, además del fútbol sudamericano.'],['📅','Temporadas completas','Avanza jornada a jornada, sigue resultados y clasificaciones y construye campañas a lo largo de toda una temporada.'],['🏆','Grandes torneos','Disputa copas nacionales, Libertadores, Champions OAB, Europa OAB y el Mundial de Clubes dentro de tu campaña.'],['🎨','Personalización','Edita jugadores y representa a tu equipo dentro de la identidad visual del juego.'],['🎁','Progresión','Recompensas, misiones y sistemas recurrentes ofrecen motivos para volver y seguir progresando.']],
    insideEyebrow: 'Actualización Europa', insideTitle: 'Una temporada más grande. Nuevos caminos hacia la copa.', insideText: 'Mira las capturas oficiales de la versión actual de Olha a Batida, localizadas para cada idioma.', screenshotAlt: 'Captura de Olha a Batida',
    faqEyebrow: 'Preguntas frecuentes', faqTitle: 'Antes de entrar al campo.', faq: [['¿Olha a Batida es gratuito?','Sí. El juego se puede descargar gratuitamente y utiliza anuncios para apoyar el desarrollo.'],['¿En qué plataformas está disponible?','Actualmente, Olha a Batida está publicado para Android e iOS.'],['¿Es una simulación 11 contra 11?','No. La propuesta es diferente: concentrar la emoción del fútbol en los momentos decisivos, con los penaltis como núcleo del gameplay y competiciones/temporadas como contexto.'],['¿Olha a Batida seguirá recibiendo novedades?','Sí. El juego continúa evolucionando con mejoras, contenido y nuevas experiencias. Realeiros anuncia novedades concretas cuando cada iniciativa está cerca de llegar a los jugadores.']], faqHelpQ: '¿Necesitas ayuda con el juego?', faqHelpA: 'Accede a la página de', support: 'soporte', or: 'o abre el', contact: 'formulario de contacto',
    finalEyebrow: 'Llega el momento decisivo', finalTitle: '¡HAZ QUE CUENTE!', finalText: 'Descárgalo en el móvil y entra en el juego.',
  },
}[locale];

const screenshotLocale = locale === 'pt-BR' ? 'pt' : locale;
const screenshots = [1, 2, 3, 4, 5, 6];
---

<BaseLayout title="Olha a Batida: Pênaltis" description={copy.description} image="/images/oab/hero.png" locale={locale} localizedAlternates>
  <section class="game-hero"><div class="container game-hero-grid"><div class="game-hero-copy"><img class="game-icon-large" src="/images/oab/icon.png" alt="Olha a Batida" width="240" height="240" /><p class="eyebrow">{copy.eyebrow}</p><h1>Olha a <span>Batida</span></h1><p>{copy.intro}</p><StoreButtons locale={locale} /></div><div class="game-hero-poster"><img src="/images/oab/hero.png" alt={copy.heroAlt} width="1024" height="500" /></div></div></section>

  <section class="section section-paper"><div class="container"><SectionHeading eyebrow={copy.whyEyebrow} title={copy.whyTitle} text={copy.whyText} /><div class="feature-grid">{copy.features.map(([icon,title,text]) => <article class="feature-box"><div class="icon">{icon}</div><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="section oab-gallery-section"><div class="container"><SectionHeading eyebrow={copy.insideEyebrow} title={copy.insideTitle} text={copy.insideText} /><div class="oab-gallery">{screenshots.map((id) => <figure><img src={`/images/oab/screenshots/${screenshotLocale}/${id}.png`} alt={`${copy.screenshotAlt} ${id}`} loading="lazy" /></figure>)}</div></div></section>

  <section class="section section-muted"><div class="container"><SectionHeading eyebrow={copy.faqEyebrow} title={copy.faqTitle} /><div class="faq">{copy.faq.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}<details><summary>{copy.faqHelpQ}</summary><p>{copy.faqHelpA} <a href={href('/suporte')}>{copy.support}</a> {copy.or} <a href={`${href('/contato')}?tipo=support#formulario`}>{copy.contact}</a>.</p></details></div></div></section>

  <section class="section"><div class="container cta-panel"><div><p class="eyebrow">{copy.finalEyebrow}</p><h2>{copy.finalTitle}</h2><p>{copy.finalText}</p></div><div class="game-download-panel"><div class="cta-panel-actions"><StoreButtons locale={locale} /></div></div></div></section>
</BaseLayout>


<style>
  .oab-gallery-section { background:linear-gradient(180deg,#06142d 0%,#081a38 100%); }
  .oab-gallery { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:18px; align-items:start; }
  .oab-gallery figure { margin:0; overflow:hidden; border:1px solid rgba(255,255,255,.1); border-radius:18px; background:#0b1e3b; box-shadow:0 14px 36px rgba(0,0,0,.24); }
  .oab-gallery img { display:block; width:100%; height:auto; }
  @media (max-width:900px) { .oab-gallery { grid-template-columns:repeat(2,minmax(0,1fr)); } }
  @media (max-width:560px) { .oab-gallery { grid-template-columns:1fr; gap:16px; } }
</style>