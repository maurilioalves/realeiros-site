---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { localizePath, type RouteLocale } from '../i18n/config';

interface Props { locale?: RouteLocale; }
const { locale = 'pt-BR' } = Astro.props;
const href = (path: string) => localizePath(path, locale);
const copy = {
  'pt-BR': {
    description: 'Olha a Batida é o jogo mobile de futebol da Realeiros Play: pênaltis, temporadas, copas, clubes, seleções, estádios e personalização no Android e iOS.', eyebrow: 'Jogo mobile • Android e iOS', intro: 'A fantasia do futebol brasileiro e mundial condensada nos momentos decisivos. Entre em campeonatos, escolha seu time e carregue a pressão de cada cobrança de pênalti.', heroAlt: 'Arte promocional oficial do Olha a Batida',
    whyEyebrow: 'Por que jogar', whyTitle: 'Simples na batida. Grande no contexto.', whyText: 'O pênalti é a ação. Competições, temporadas, personalização e progressão dão significado ao que acontece antes e depois dele.',
    features: [['⚽','Pênaltis que decidem','Cobre, defenda e lide com a pressão de partidas resolvidas nos detalhes.'],['🏆','Competições','Dispute campeonatos, copas nacionais e torneios continentais com clubes e seleções.'],['📅','Temporadas','Avance rodada a rodada, acompanhe resultados e construa campanhas que vão além de uma partida isolada.'],['🏟️','Estádios','Ambientes inspirados no futebol sul-americano ajudam cada partida a ter sua própria atmosfera.'],['🎨','Personalização','Edite jogadores e represente o seu time dentro da identidade visual do jogo.'],['🎁','Progressão','Recompensas, missões e sistemas recorrentes dão motivo para voltar e continuar evoluindo.']],
    insideEyebrow: 'Dentro do jogo', insideTitle: 'Futebol com cara própria.', insideText: 'Capturas oficiais publicadas na loja do jogo.', shots: [['2.png','Cobranças de pênalti no Olha a Batida','Cobranças e defesas com controles acessíveis.'],['12.png','Competições do Olha a Batida','Competições e temporadas para dar contexto às partidas.'],['16.png','Personalização de jogadores no Olha a Batida','Personalização do elenco e do jogador.'],['14.png','Estádios do Olha a Batida','Estádios e atmosferas diferentes para cada disputa.'],['10.png','Clubes disponíveis no Olha a Batida','Clubes e identidade de torcida.'],['6.png','Tela de campeão no Olha a Batida','Campanhas que terminam com taça — ou com vontade de tentar de novo.']],
    faqEyebrow: 'Perguntas frequentes', faqTitle: 'Antes de entrar em campo.', faq: [['O Olha a Batida é gratuito?','Sim. O jogo pode ser baixado gratuitamente. Ele utiliza anúncios e pode oferecer compras dentro do aplicativo conforme a versão disponível nas lojas.'],['Em quais plataformas está disponível?','Atualmente, o Olha a Batida está publicado para Android e iOS.'],['O jogo é uma simulação 11x11?','Não. A proposta é outra: concentrar a emoção do futebol nos momentos decisivos, com pênaltis como core gameplay e competições/temporadas como contexto.'],['O Olha a Batida continuará recebendo novidades?','Sim. O jogo continua em evolução com melhorias, conteúdo e novas experiências. A Realeiros anuncia novidades específicas quando cada frente está próxima de chegar aos jogadores.']], faqHelpQ: 'Preciso de ajuda com o jogo?', faqHelpA: 'Acesse a página de', support: 'suporte', or: 'ou abra o', contact: 'formulário de contato',
    finalEyebrow: 'Já diria o poeta', finalTitle: 'AGORA EU SE CONSAGRO!', finalText: 'Baixe no celular e entre no jogo.',
  },
  en: {
    description: 'Olha a Batida is Realeiros Play’s mobile football game: penalties, seasons, cups, clubs, national teams, stadiums and customization on Android and iOS.', eyebrow: 'Mobile game • Android and iOS', intro: 'The fantasy of Brazilian and world football condensed into its decisive moments. Enter competitions, choose your team and feel the pressure of every penalty kick.', heroAlt: 'Official Olha a Batida promotional artwork',
    whyEyebrow: 'Why play', whyTitle: 'Simple at the spot. Big in context.', whyText: 'The penalty is the action. Competitions, seasons, customization and progression give meaning to what happens before and after it.',
    features: [['⚽','Decisive penalties','Take shots, make saves and handle the pressure of matches decided by details.'],['🏆','Competitions','Play leagues, domestic cups and continental tournaments with clubs and national teams.'],['📅','Seasons','Advance round by round, follow results and build campaigns that go beyond a single match.'],['🏟️','Stadiums','Environments inspired by South American football give each match its own atmosphere.'],['🎨','Customization','Edit players and represent your team within the game’s visual identity.'],['🎁','Progression','Rewards, missions and recurring systems give you reasons to return and keep improving.']],
    insideEyebrow: 'Inside the game', insideTitle: 'Football with its own identity.', insideText: 'Official screenshots published on the game’s store pages.', shots: [['2.png','Penalty kicks in Olha a Batida','Shots and saves with accessible controls.'],['12.png','Olha a Batida competitions','Competitions and seasons that give matches context.'],['16.png','Player customization in Olha a Batida','Squad and player customization.'],['14.png','Olha a Batida stadiums','Different stadiums and atmospheres for every contest.'],['10.png','Clubs available in Olha a Batida','Clubs and supporter identity.'],['6.png','Champion screen in Olha a Batida','Campaigns that end with a trophy — or the urge to try again.']],
    faqEyebrow: 'FAQ', faqTitle: 'Before you step onto the pitch.', faq: [['Is Olha a Batida free?','Yes. The game can be downloaded for free. It uses ads and may offer in-app purchases depending on the version available in the stores.'],['Which platforms is it available on?','Olha a Batida is currently published for Android and iOS.'],['Is it an 11v11 simulation?','No. The goal is different: concentrate football’s emotion in decisive moments, using penalties as the core gameplay and competitions/seasons as context.'],['Will Olha a Batida keep receiving updates?','Yes. The game continues to evolve with improvements, content and new experiences. Realeiros announces specific updates when each initiative is close to reaching players.']], faqHelpQ: 'Need help with the game?', faqHelpA: 'Visit the', support: 'support page', or: 'or open the', contact: 'contact form',
    finalEyebrow: 'Time for the big moment', finalTitle: 'MAKE YOUR MOMENT COUNT!', finalText: 'Download it on your phone and get into the game.',
  },
  es: {
    description: 'Olha a Batida es el juego móvil de fútbol de Realeiros Play: penaltis, temporadas, copas, clubes, selecciones, estadios y personalización en Android e iOS.', eyebrow: 'Juego móvil • Android e iOS', intro: 'La fantasía del fútbol brasileño y mundial concentrada en sus momentos decisivos. Entra en competiciones, elige tu equipo y siente la presión de cada lanzamiento de penalti.', heroAlt: 'Arte promocional oficial de Olha a Batida',
    whyEyebrow: 'Por qué jugar', whyTitle: 'Simple desde el punto. Grande en contexto.', whyText: 'El penalti es la acción. Competiciones, temporadas, personalización y progresión dan significado a lo que ocurre antes y después.',
    features: [['⚽','Penaltis decisivos','Lanza, para y afronta la presión de partidos resueltos por pequeños detalles.'],['🏆','Competiciones','Disputa ligas, copas nacionales y torneos continentales con clubes y selecciones.'],['📅','Temporadas','Avanza jornada a jornada, sigue los resultados y construye campañas que van más allá de un solo partido.'],['🏟️','Estadios','Ambientes inspirados en el fútbol sudamericano ayudan a que cada partido tenga su propia atmósfera.'],['🎨','Personalización','Edita jugadores y representa a tu equipo dentro de la identidad visual del juego.'],['🎁','Progresión','Recompensas, misiones y sistemas recurrentes ofrecen motivos para volver y seguir progresando.']],
    insideEyebrow: 'Dentro del juego', insideTitle: 'Fútbol con identidad propia.', insideText: 'Capturas oficiales publicadas en las tiendas del juego.', shots: [['2.png','Lanzamientos de penalti en Olha a Batida','Lanzamientos y paradas con controles accesibles.'],['12.png','Competiciones de Olha a Batida','Competiciones y temporadas que dan contexto a los partidos.'],['16.png','Personalización de jugadores en Olha a Batida','Personalización de la plantilla y del jugador.'],['14.png','Estadios de Olha a Batida','Estadios y ambientes distintos para cada disputa.'],['10.png','Clubes disponibles en Olha a Batida','Clubes e identidad de afición.'],['6.png','Pantalla de campeón en Olha a Batida','Campañas que terminan con trofeo — o con ganas de volver a intentarlo.']],
    faqEyebrow: 'Preguntas frecuentes', faqTitle: 'Antes de entrar al campo.', faq: [['¿Olha a Batida es gratuito?','Sí. El juego se puede descargar gratuitamente. Utiliza anuncios y puede ofrecer compras dentro de la aplicación según la versión disponible en las tiendas.'],['¿En qué plataformas está disponible?','Actualmente, Olha a Batida está publicado para Android e iOS.'],['¿Es una simulación 11 contra 11?','No. La propuesta es diferente: concentrar la emoción del fútbol en los momentos decisivos, con los penaltis como núcleo del gameplay y competiciones/temporadas como contexto.'],['¿Olha a Batida seguirá recibiendo novedades?','Sí. El juego continúa evolucionando con mejoras, contenido y nuevas experiencias. Realeiros anuncia novedades concretas cuando cada iniciativa está cerca de llegar a los jugadores.']], faqHelpQ: '¿Necesitas ayuda con el juego?', faqHelpA: 'Accede a la página de', support: 'soporte', or: 'o abre el', contact: 'formulario de contacto',
    finalEyebrow: 'Llega el momento decisivo', finalTitle: '¡HAZ QUE CUENTE!', finalText: 'Descárgalo en el móvil y entra en el juego.',
  },
}[locale];
---

<BaseLayout title="Olha a Batida" description={copy.description} locale={locale} localizedAlternates>
  <section class="game-hero"><div class="container game-hero-grid"><div class="game-hero-copy"><img class="game-icon-large" src="/images/oab/icon.png" alt="Olha a Batida" width="240" height="240" /><p class="eyebrow">{copy.eyebrow}</p><h1>Olha a <span>Batida</span></h1><p>{copy.intro}</p><StoreButtons locale={locale} /></div><div class="game-hero-poster"><img src="/images/oab/criativos/1.png" alt={copy.heroAlt} width="526" height="296" /></div></div></section>

  <section class="section section-paper"><div class="container"><SectionHeading eyebrow={copy.whyEyebrow} title={copy.whyTitle} text={copy.whyText} /><div class="feature-grid">{copy.features.map(([icon,title,text]) => <article class="feature-box"><div class="icon">{icon}</div><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="section"><div class="container"><SectionHeading eyebrow={copy.insideEyebrow} title={copy.insideTitle} text={copy.insideText} /><div class="screenshot-grid">{copy.shots.map(([file,alt,caption]) => <figure class="screenshot-card"><img src={`/images/oab/criativos/${file}`} alt={alt} width="526" height="296" loading="lazy" /><figcaption>{caption}</figcaption></figure>)}</div></div></section>

  <section class="section section-muted"><div class="container"><SectionHeading eyebrow={copy.faqEyebrow} title={copy.faqTitle} /><div class="faq">{copy.faq.map(([q,a]) => <details><summary>{q}</summary><p>{a}</p></details>)}<details><summary>{copy.faqHelpQ}</summary><p>{copy.faqHelpA} <a href={href('/suporte')}>{copy.support}</a> {copy.or} <a href={`${href('/contato')}?tipo=support#formulario`}>{copy.contact}</a>.</p></details></div></div></section>

  <section class="section"><div class="container cta-panel"><div><p class="eyebrow">{copy.finalEyebrow}</p><h2>{copy.finalTitle}</h2><p>{copy.finalText}</p></div><div class="game-download-panel"><img class="game-download-logo" src="/images/oab/banner_game_clean_PT.png" alt="Olha a Batida" /><div class="cta-panel-actions"><StoreButtons locale={locale} /></div></div></div></section>
</BaseLayout>
