---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { site } from '../data/site';
import { localizePath, type RouteLocale } from '../i18n/config';
import ptCopy from '../i18n/press-kit-pt';
import enCopy from '../i18n/press-kit-en';
import esCopy from '../i18n/press-kit-es';
import '../styles/press-kit.css';

interface Props { locale?: RouteLocale; }
const { locale = 'pt-BR' } = Astro.props;
const copy = locale === 'en' ? enCopy : locale === 'es' ? esCopy : ptCopy;
const href = (path: string) => localizePath(path, locale);
const screenshotFiles = ['01-gameplay-penalti.jpg','02-temporadas.jpg','03-clubes.jpg','04-selecoes.jpg','05-personalizacao.jpg','06-campeao.jpg','07-trofeus.jpg','08-estadios.jpg'];
const realeirosAssets = [['realeiros-institucional.png','PNG','/press-kit/realeiros/realeiros-institucional.png'],['realeiros-symbol.png','PNG','/press-kit/realeiros/realeiros-symbol.png'],['realeiros-vetor.svg','SVG','/press-kit/realeiros/realeiros-vetor.svg']];
const gameAssets = [['olha-a-batida-logo.png','PNG','/press-kit/olha-a-batida/olha-a-batida-logo.png'],['olha-a-batida-icon.png','PNG','/press-kit/olha-a-batida/olha-a-batida-icon.png'],['olha-a-batida-key-art.png','PNG','/press-kit/olha-a-batida/olha-a-batida-key-art.png'],['olha-a-batida-feature-graphic.png','PNG','/press-kit/olha-a-batida/olha-a-batida-feature-graphic.png']];
---

<BaseLayout title="Press Kit" description={copy.description} locale={locale} localizedAlternates>
  <PageHero eyebrow="Press Kit" title={copy.heroTitle} text={copy.heroText} />

  <section class="section"><div class="container press-studio-grid"><div class="press-studio-logo"><img src="/press-kit/realeiros/realeiros-institucional.png" alt="Realeiros Play" width="1080" height="1080" /></div><div class="press-studio-copy"><p class="eyebrow">{copy.studioEyebrow}</p><h2>{copy.studioTitle}</h2>{copy.studioBody.map((text,index) => <p>{index === 1 ? <>{text.split('Olha a Batida')[0]}<strong>Olha a Batida</strong>{text.split('Olha a Batida')[1]}</> : text}</p>)}<dl class="press-studio-meta">{copy.meta.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div></div></section>

  <section class="section section-paper"><div class="container"><div class="press-game-heading"><div><p class="eyebrow">{copy.mainTitle}</p><img class="press-game-logo" src="/press-kit/olha-a-batida/olha-a-batida-logo.png" alt="Olha a Batida" /><p class="press-game-lead">{copy.gameLead}</p></div><img class="press-game-icon" src="/press-kit/olha-a-batida/olha-a-batida-icon.png" alt="Olha a Batida" /></div><div class="press-metrics" aria-label={copy.metricsAria}>{copy.metrics.map(([value,label]) => <div><strong>{value}</strong><span>{label}</span></div>)}</div><div class="press-facts-layout"><div><SectionHeading eyebrow="Fact Sheet" title="Olha a Batida" /><dl class="press-fact-sheet">{copy.facts.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl></div><div class="press-store-panel"><img src="/press-kit/olha-a-batida/olha-a-batida-key-art.png" alt="Olha a Batida" /><h3>{copy.storeTitle}</h3><p>{copy.storeText}</p><StoreButtons locale={locale} /></div></div></div></section>

  <section class="section"><div class="container"><SectionHeading eyebrow={copy.pubEyebrow} title={copy.pubTitle} text={copy.pubText} /><div class="press-copy-grid">{copy.publication.map(([label,text],index) => <article class:list={['press-copy-card', index === 2 && 'press-copy-card-wide']}><span>{label}</span>{text.split('\n\n').map((part) => <p>{part}</p>)}</article>)}</div></div></section>
  <section class="section section-muted"><div class="container"><SectionHeading eyebrow={copy.featureEyebrow} title={copy.featureTitle} /><div class="press-feature-grid">{copy.features.map(([title,text]) => <article><h3>{title}</h3><p>{text}</p></article>)}</div></div></section>

  <section class="section"><div class="container press-gallery"><SectionHeading eyebrow={copy.screenshotEyebrow} title={copy.screenshotTitle} text={copy.screenshotText} /><div class="press-screenshot-grid">{screenshotFiles.map((file,index) => { const imageHref = `/press-kit/olha-a-batida/screenshots/${file}`; const [label,alt] = copy.screenshotLabels[index]; return <figure class="press-screenshot-card"><a href={imageHref} download aria-label={`${copy.downloadScreenshot}: ${label}`}><img src={imageHref} alt={alt} loading="lazy" /></a><figcaption><span>{label}</span><a class="press-screenshot-download" href={imageHref} download>{copy.downloadJpg}</a></figcaption></figure>; })}</div></div></section>

  <section class="section section-paper press-assets"><div class="container"><SectionHeading eyebrow={copy.assetsEyebrow} title={copy.assetsTitle} text={copy.assetsText} /><div class="press-bundle-card"><div><strong>{copy.bundleTitle}</strong><p>{copy.bundleText}</p></div><a class="button button-dark" href="/press-kit/realeiros-play-press-kit.zip" download>{copy.bundleButton}</a></div><h3 class="press-assets-title">Realeiros Play</h3><div class="press-assets-grid">{realeirosAssets.map(([file,format,assetHref],index) => <article class="press-asset-card"><div class="press-asset-preview"><img src={assetHref} alt={copy.assetLabels[index]} loading="lazy" /></div><div class="press-asset-info"><div><strong>{copy.assetLabels[index]}</strong><span>{file}</span></div><a class="button button-dark button-small" href={assetHref} download>{copy.download} {format}</a></div></article>)}</div><h3 class="press-assets-title press-assets-title-spaced">Olha a Batida</h3><div class="press-assets-grid">{gameAssets.map(([file,format,assetHref],index) => <article class="press-asset-card"><div class="press-asset-preview"><img src={assetHref} alt={copy.assetLabels[index + 3]} loading="lazy" /></div><div class="press-asset-info"><div><strong>{copy.assetLabels[index + 3]}</strong><span>{file}</span></div><a class="button button-dark button-small" href={assetHref} download>{copy.download} {format}</a></div></article>)}</div></div></section>

  <section class="section"><div class="container press-usage-grid"><div><p class="eyebrow">{copy.usageEyebrow}</p><h2>{copy.usageTitle}</h2><p>{copy.usageText}</p></div><div class="press-contact-card"><span>{copy.contactEyebrow}</span><h3>{copy.contactTitle}</h3><p>{copy.contactText}</p><a class="button button-primary" href={`${href('/contato')}?tipo=press_creator#formulario`}>{copy.contactButton}</a><small>{copy.fallback}: {site.email}</small></div></div></section>
</BaseLayout>
