---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site';
import { localizePath, type RouteLocale } from '../i18n/config';

interface Props { locale?: RouteLocale; }
const { locale = 'pt-BR' } = Astro.props;
const href = (path: string) => localizePath(path, locale);
const copy = {
  'pt-BR': {
    title: 'Exclusão de Dados', description: 'Como solicitar exclusão de dados relacionados aos serviços da Realeiros Play.', heroEyebrow: 'Privacidade', heroText: 'Como solicitar análise e exclusão de dados relacionados ao Olha a Batida e aos serviços da Realeiros Play.',
    sections: [
      ['O Olha a Batida possui conta de usuário?',['Atualmente, o Olha a Batida não exige nem oferece a criação de uma conta própria da Realeiros Play para jogar.','Grande parte das informações de progresso, preferências, configurações e partidas salvas permanece armazenada localmente no dispositivo.']],
      ['Dados armazenados no dispositivo',['Dados locais do jogo podem ser removidos utilizando os recursos disponíveis no próprio sistema operacional, como limpeza dos dados do aplicativo ou desinstalação.','A Realeiros Play não consegue apagar remotamente dados que estejam armazenados exclusivamente no dispositivo do jogador.']],
      ['Dados tratados por serviços online',['O aplicativo utiliza serviços de terceiros para funcionalidades como analytics, publicidade, diagnóstico, distribuição e processamento de compras.','Dependendo do serviço utilizado, determinadas informações técnicas ou de uso podem ser tratadas por fornecedores como Google, Firebase, Unity e pelas lojas de aplicativos.','Caso você queira solicitar análise ou exclusão de dados que possam estar relacionados ao uso do Olha a Batida, entre em contato conosco.']],
    ], howTitle: 'Como solicitar', howA: 'Acesse o', form: 'formulário de contato', howB: ', mantenha a categoria “Privacidade e dados” selecionada e informe na mensagem que se trata de uma solicitação de exclusão de dados.', minimum: 'Informe apenas os dados necessários para que possamos analisar a solicitação:', list: ['jogo ou serviço relacionado;','plataforma utilizada, como Android ou iOS;','descrição objetiva do dado ou informação que deseja excluir;','identificador técnico, comprovante ou outra informação de referência somente quando necessário para localizar os dados relacionados à solicitação.'],
    afterTitle: 'O que acontece depois', after: ['A Realeiros Play analisará a solicitação e verificará quais informações podem estar sob seu controle direto ou podem ser relacionadas tecnicamente ao usuário.','Quando a informação estiver sob controle direto da Realeiros Play e a exclusão for aplicável, adotaremos as medidas cabíveis para removê-la ou anonimizar seu vínculo com o titular.','Informações mantidas diretamente por serviços de terceiros, lojas de aplicativos ou plataformas poderão estar sujeitas aos procedimentos e prazos definidos por esses fornecedores.'],
    keepTitle: 'Informações que podem precisar ser mantidas', keep: 'Em determinadas situações, algumas informações poderão ser mantidas quando isso for necessário para cumprimento de obrigação legal, prevenção a fraude, segurança, defesa de direitos ou outras hipóteses permitidas pela legislação aplicável.', securityTitle: 'Segurança da solicitação', security: ['Não envie senhas, números completos de cartão, credenciais de acesso ou documentos que não sejam necessários para a solicitação.','Se precisarmos confirmar a legitimidade de uma solicitação ou localizar informações específicas, solicitaremos apenas o mínimo necessário para essa finalidade.'], rightsTitle: 'Outros direitos relacionados a dados pessoais', rights: 'Além da exclusão, a legislação aplicável pode garantir outros direitos relacionados a dados pessoais, incluindo confirmação da existência de tratamento, acesso, correção e informações sobre compartilhamento.', privacyPrefix: 'Consulte a', privacyLink: 'Política de Privacidade', privacySuffix: 'para informações completas sobre tratamento de dados e direitos dos titulares.', contactTitle: 'Contato', primary: 'Canal principal', alternative: 'Canal alternativo',
  },
  en: {
    title: 'Data Deletion', description: 'How to request deletion of data related to Realeiros Play services.', heroEyebrow: 'Privacy', heroText: 'How to request a review and deletion of data related to Olha a Batida and Realeiros Play services.',
    sections: [
      ['Does Olha a Batida have user accounts?',['Olha a Batida currently does not require or offer the creation of a Realeiros Play account to play.','A large part of progress, preferences, settings and saved-match information remains stored locally on the device.']],
      ['Data stored on the device',['Local game data can be removed using operating-system features such as clearing app data or uninstalling the application.','Realeiros Play cannot remotely delete data that is stored exclusively on the player’s device.']],
      ['Data processed by online services',['The application uses third-party services for features such as analytics, advertising, diagnostics, distribution and purchase processing.','Depending on the service used, certain technical or usage information may be processed by providers such as Google, Firebase, Unity and app stores.','If you would like to request a review or deletion of data that may be related to your use of Olha a Batida, contact us.']],
    ], howTitle: 'How to request deletion', howA: 'Open the', form: 'contact form', howB: ', keep the “Privacy and data” category selected and state in your message that you are requesting data deletion.', minimum: 'Provide only the information needed for us to review the request:', list: ['the related game or service;','the platform used, such as Android or iOS;','a clear description of the data or information you want deleted;','a technical identifier, receipt or other reference information only when necessary to locate data related to the request.'],
    afterTitle: 'What happens next', after: ['Realeiros Play will review the request and determine what information may be under its direct control or can be technically associated with the user.','When the information is under Realeiros Play’s direct control and deletion applies, we will take appropriate measures to remove it or anonymize its link to the data subject.','Information maintained directly by third-party services, app stores or platforms may be subject to procedures and timelines defined by those providers.'],
    keepTitle: 'Information that may need to be retained', keep: 'In some situations, certain information may be retained when necessary to comply with legal obligations, prevent fraud, protect security, defend rights or under other grounds permitted by applicable law.', securityTitle: 'Request security', security: ['Do not send passwords, full card numbers, access credentials or documents that are not necessary for the request.','If we need to confirm the legitimacy of a request or locate specific information, we will request only the minimum information needed for that purpose.'], rightsTitle: 'Other personal-data rights', rights: 'In addition to deletion, applicable law may provide other rights related to personal data, including confirmation of processing, access, correction and information about sharing.', privacyPrefix: 'See the', privacyLink: 'Privacy Policy', privacySuffix: 'for full information about data processing and data-subject rights.', contactTitle: 'Contact', primary: 'Primary channel', alternative: 'Alternative channel',
  },
  es: {
    title: 'Eliminación de Datos', description: 'Cómo solicitar la eliminación de datos relacionados con los servicios de Realeiros Play.', heroEyebrow: 'Privacidad', heroText: 'Cómo solicitar el análisis y la eliminación de datos relacionados con Olha a Batida y los servicios de Realeiros Play.',
    sections: [
      ['¿Olha a Batida tiene cuentas de usuario?',['Actualmente, Olha a Batida no exige ni ofrece la creación de una cuenta propia de Realeiros Play para jugar.','Gran parte de la información de progreso, preferencias, ajustes y partidas guardadas permanece almacenada localmente en el dispositivo.']],
      ['Datos almacenados en el dispositivo',['Los datos locales del juego pueden eliminarse utilizando las funciones disponibles en el propio sistema operativo, como borrar los datos de la aplicación o desinstalarla.','Realeiros Play no puede eliminar de forma remota datos que estén almacenados exclusivamente en el dispositivo del jugador.']],
      ['Datos tratados por servicios online',['La aplicación utiliza servicios de terceros para funciones como analítica, publicidad, diagnóstico, distribución y procesamiento de compras.','Dependiendo del servicio utilizado, determinados datos técnicos o de uso pueden ser tratados por proveedores como Google, Firebase, Unity y las tiendas de aplicaciones.','Si quieres solicitar el análisis o la eliminación de datos que puedan estar relacionados con el uso de Olha a Batida, contacta con nosotros.']],
    ], howTitle: 'Cómo solicitarlo', howA: 'Accede al', form: 'formulario de contacto', howB: ', mantén seleccionada la categoría “Privacidad y datos” e indica en el mensaje que se trata de una solicitud de eliminación de datos.', minimum: 'Proporciona solo los datos necesarios para que podamos analizar la solicitud:', list: ['juego o servicio relacionado;','plataforma utilizada, como Android o iOS;','descripción clara del dato o información que deseas eliminar;','identificador técnico, comprobante u otra información de referencia solo cuando sea necesaria para localizar los datos relacionados con la solicitud.'],
    afterTitle: 'Qué ocurre después', after: ['Realeiros Play analizará la solicitud y comprobará qué información puede estar bajo su control directo o puede relacionarse técnicamente con el usuario.','Cuando la información esté bajo control directo de Realeiros Play y la eliminación sea aplicable, adoptaremos las medidas adecuadas para eliminarla o anonimizar su vínculo con el titular.','La información mantenida directamente por servicios de terceros, tiendas de aplicaciones o plataformas puede estar sujeta a los procedimientos y plazos definidos por esos proveedores.'],
    keepTitle: 'Información que puede necesitar conservarse', keep: 'En determinadas situaciones, cierta información podrá conservarse cuando sea necesario para cumplir obligaciones legales, prevenir fraudes, proteger la seguridad, defender derechos u otras hipótesis permitidas por la legislación aplicable.', securityTitle: 'Seguridad de la solicitud', security: ['No envíes contraseñas, números completos de tarjeta, credenciales de acceso ni documentos que no sean necesarios para la solicitud.','Si necesitamos confirmar la legitimidad de una solicitud o localizar información específica, pediremos únicamente lo mínimo necesario para ese fin.'], rightsTitle: 'Otros derechos relacionados con datos personales', rights: 'Además de la eliminación, la legislación aplicable puede garantizar otros derechos relacionados con datos personales, como confirmación de tratamiento, acceso, corrección e información sobre compartición.', privacyPrefix: 'Consulta la', privacyLink: 'Política de Privacidad', privacySuffix: 'para obtener información completa sobre el tratamiento de datos y los derechos de los titulares.', contactTitle: 'Contacto', primary: 'Canal principal', alternative: 'Canal alternativo',
  },
}[locale];
---

<BaseLayout title={copy.title} description={copy.description} locale={locale} localizedAlternates>
  <PageHero eyebrow={copy.heroEyebrow} title={copy.title} text={copy.heroText} />
  <section class="section"><div class="container prose">
    {copy.sections.map(([title,paragraphs]) => <><h2>{title}</h2>{paragraphs.map((text) => <p>{text}</p>)}</>)}
    <h2>{copy.howTitle}</h2><p>{copy.howA} <a href={`${href('/contato')}?tipo=privacy#formulario`}>{copy.form}</a>{copy.howB}</p><p>{copy.minimum}</p><ul>{copy.list.map((item) => <li>{item}</li>)}</ul>
    <h2>{copy.afterTitle}</h2>{copy.after.map((text) => <p>{text}</p>)}
    <h2>{copy.keepTitle}</h2><p>{copy.keep}</p>
    <h2>{copy.securityTitle}</h2>{copy.security.map((text) => <p>{text}</p>)}
    <h2>{copy.rightsTitle}</h2><p>{copy.rights}</p><p>{copy.privacyPrefix} <a href={href('/privacidade')}>{copy.privacyLink}</a> {copy.privacySuffix}</p>
    <h2>{copy.contactTitle}</h2><p><strong>Realeiros Play</strong><br />{copy.primary}: <a href={`${href('/contato')}?tipo=privacy#formulario`}>{copy.form}</a><br />{copy.alternative}: {site.email}</p>
  </div></section>
</BaseLayout>
