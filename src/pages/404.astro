---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Página não encontrada" noindex>
  <section class="page-hero">
    <div class="container narrow">
      <p class="eyebrow">404 • A bola saiu do estádio</p>
      <h1>Essa página não existe.</h1>
      <p class="lead">Pode ter sido movida, aposentada ou só mandou a cobrança lá na arquibancada.</p>
      <div class="hero-actions"><a class="button button-primary" href="/">Voltar para a home</a><a class="button button-secondary" href="/olha-a-batida">Ir para o Olha a Batida</a></div>
    </div>
  </section>
</BaseLayout>
