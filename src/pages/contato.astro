---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";
import PageHero from "../components/PageHero.astro";
import { site } from "../data/site";
import "../styles/contact.css";
---

<BaseLayout
  title="Contato"
  description="Fale com a Realeiros Play sobre suporte, imprensa, criadores, parcerias, privacidade e assuntos gerais."
>
  <PageHero
    eyebrow="Contato"
    title="Fale com a Realeiros."
    text="Escolha o assunto e envie sua mensagem sem sair do site. O formulário direciona o contato para o contexto certo."
  />

  <section class="section">
    <div class="container contact-grid">
      <article class="contact-card">
        <span>Jogadores</span>
        <h2>Suporte do Olha a Batida</h2>
        <p>
          Bug, problema de acesso, compra, anúncio ou dúvida sobre o jogo.
        </p>
        <div class="contact-card-actions">
          <a
            href="/contato?tipo=support#formulario"
            data-contact-type="support"
          >Abrir suporte</a>
          <a href="/suporte">Ver central de suporte</a>
        </div>
      </article>

      <article class="contact-card">
        <span>Imprensa e criadores</span>
        <h2>Conteúdo, cobertura e materiais</h2>
        <p>
          Informações, logos, screenshots, dados públicos e materiais oficiais
          estão disponíveis no Press Kit.
        </p>
        <div class="contact-card-actions">
          <a href="/press-kit">Acessar Press Kit</a>
          <a
            href="/contato?tipo=press_creator#formulario"
            data-contact-type="press_creator"
          >Falar com a Realeiros</a>
        </div>
      </article>

      <article class="contact-card">
        <span>Negócios</span>
        <h2>Parcerias</h2>
        <p>
          Contato comercial, publishing, licenciamento e oportunidades alinhadas
          aos produtos da Realeiros.
        </p>
        <div class="contact-card-actions">
          <a
            href="/contato?tipo=partnership#formulario"
            data-contact-type="partnership"
          >Enviar proposta</a>
        </div>
      </article>

      <article class="contact-card">
        <span>Privacidade</span>
        <h2>Dados e questões legais</h2>
        <p>
          Solicitações relacionadas a privacidade, dados, termos e exclusão.
        </p>
        <div class="contact-card-actions">
          <a
            href="/contato?tipo=privacy#formulario"
            data-contact-type="privacy"
          >Falar sobre privacidade</a>
          <a href="/privacidade">Ver política</a>
        </div>
      </article>
    </div>
  </section>

  <section id="formulario" class="section section-paper contact-form-section">
    <div class="container contact-form-layout">
      <div class="contact-form-intro">
        <p class="eyebrow">Mensagem direta</p>
        <h2>Conte o que você precisa.</h2>
        <p>
          Selecione o assunto, deixe seus dados para resposta e descreva a
          solicitação. A mensagem é enviada diretamente para o canal da Realeiros.
        </p>

        <div class="contact-form-points">
          <div class="contact-form-point">
            <strong>Resposta por e-mail</strong>
            <span>Usaremos o endereço informado no formulário para dar continuidade ao contato.</span>
          </div>
          <div class="contact-form-point">
            <strong>Sem dados desnecessários</strong>
            <span>Não envie senhas, dados completos de cartão ou informações que não sejam necessárias para a solicitação.</span>
          </div>
          <div class="contact-form-point">
            <strong>Imprensa e criadores</strong>
            <span>Antes de pedir assets, confira o Press Kit: logos, artes e screenshots já estão disponíveis para download.</span>
          </div>
        </div>

        <p class="contact-form-fallback">
          Se o formulário estiver indisponível, o canal alternativo é
          <strong>{site.email}</strong>.
        </p>
      </div>

      <ContactForm accessKey="2ed9e4fa-0579-40d2-b44d-2f5f67790fad" />
    </div>
  </section>

  <section class="section section-paper">
    <div
      class="container cta-panel"
      style="background:#fff;color:#0b1730;border-color:#d8dde5"
    >
      <div>
        <p class="eyebrow">Acompanhe os bastidores</p>

        <h2 class="contact-instagram-handle">@realeirosplay</h2>

        <p style="color:#4f5b70">
          Desenvolvimento, futebol, lançamentos e o que acontece entre uma
          atualização e outra.
        </p>
      </div>

      <div class="cta-panel-actions">
        <a
          class="button button-dark"
          href={site.instagram}
          target="_blank"
          rel="noreferrer"
        >
          <img
            class="button-icon"
            src="/images/social_media/Instagram_logo.png"
            alt=""
            aria-hidden="true"
          />
          Abrir Instagram
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
