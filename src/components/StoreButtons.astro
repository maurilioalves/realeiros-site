---
import { site } from '../data/site';
import type { RouteLocale } from '../i18n/config';

interface Props {
  compact?: boolean;
  locale?: RouteLocale;
}

const { compact = false, locale = 'pt-BR' } = Astro.props;
const copy = {
  'pt-BR': {
    googleAria: 'Baixar Olha a Batida na Google Play',
    googleAlt: 'Disponível no Google Play',
    appleAria: 'Baixar Olha a Batida na App Store',
    appleAlt: 'Disponível na App Store',
  },
  en: {
    googleAria: 'Download Olha a Batida on Google Play',
    googleAlt: 'Get it on Google Play',
    appleAria: 'Download Olha a Batida on the App Store',
    appleAlt: 'Download on the App Store',
  },
  es: {
    googleAria: 'Descargar Olha a Batida en Google Play',
    googleAlt: 'Disponible en Google Play',
    appleAria: 'Descargar Olha a Batida en App Store',
    appleAlt: 'Disponible en App Store',
  },
}[locale];
---
<div class:list={['store-buttons', compact && 'store-buttons-compact']}>
  <a class="store-button" href={site.playStore} target="_blank" rel="noreferrer" aria-label={copy.googleAria}>
    <img src="/images/stores/PlayStore/googleplay_PT.png" alt={copy.googleAlt} />
  </a>
  <a class="store-button" href={site.appStore} target="_blank" rel="noreferrer" aria-label={copy.appleAria}>
    <img src="/images/stores/AppStore/appstore_PT.png" alt={copy.appleAlt} />
  </a>
</div>
