---
import { localizePath, type RouteLocale } from '../i18n/config';

interface Props {
  accessKey: string;
  locale?: RouteLocale;
}

const { accessKey, locale = 'pt-BR' } = Astro.props;
const privacyHref = localizePath('/privacidade', locale);
const copy = {
  'pt-BR': {
    subjectLabel: 'Assunto',
    name: 'Nome',
    email: 'E-mail',
    organization: 'Empresa, veículo ou canal',
    optional: '(opcional)',
    message: 'Mensagem',
    botcheck: 'Não preencha este campo',
    privacyPrefix: 'Ao enviar, os dados informados serão usados para responder à sua solicitação. Consulte a',
    privacyLink: 'Política de Privacidade',
    submit: 'Enviar mensagem',
    types: {
      support: { label: 'Suporte geral', subject: 'Suporte - Olha a Batida', hint: 'Explique sua dúvida ou problema e informe, quando ajudar, aparelho, sistema e versão do jogo.' },
      bug: { label: 'Reportar bug', subject: 'Bug - Olha a Batida', hint: 'Informe aparelho, Android/iOS, versão do jogo, onde ocorreu, o que aconteceu e como reproduzir o problema.' },
      purchase_ads: { label: 'Compras e anúncios', subject: 'Compra ou anúncio - Olha a Batida', hint: 'Descreva o problema. Não envie senha ou dados completos de cartão; informe identificador do pedido apenas quando necessário.' },
      feedback: { label: 'Feedback e sugestões', subject: 'Feedback - Olha a Batida', hint: 'Conte sua ideia, sugestão ou percepção sobre o jogo. O envio entra como sinal para evolução do produto.' },
      press_creator: { label: 'Imprensa e criadores', subject: 'Imprensa e Criadores - Realeiros Play', hint: 'Informe veículo, canal ou contexto da cobertura e o material ou informação de que precisa.' },
      partnership: { label: 'Parcerias', subject: 'Parceria - Realeiros Play', hint: 'Apresente a organização, a oportunidade e o formato de parceria, publishing, licenciamento ou proposta comercial.' },
      privacy: { label: 'Privacidade e dados', subject: 'Privacidade e dados - Realeiros Play', hint: 'Descreva a solicitação de privacidade, dados ou exclusão e informe apenas o mínimo necessário para análise.' },
      general: { label: 'Outro assunto', subject: 'Contato pelo site - Realeiros Play', hint: 'Conte de forma objetiva como podemos ajudar.' },
    },
    runtime: {
      sending: 'Enviando...',
      sendingMessage: 'Enviando sua mensagem...',
      success: 'Mensagem enviada. Obrigado pelo contato — responderemos pelo e-mail informado.',
      error: 'Não foi possível enviar agora. Tente novamente em alguns instantes ou use o e-mail de fallback informado ao lado.',
      submit: 'Enviar mensagem',
    },
  },
  en: {
    subjectLabel: 'Subject',
    name: 'Name',
    email: 'Email',
    organization: 'Company, publication or channel',
    optional: '(optional)',
    message: 'Message',
    botcheck: 'Do not fill in this field',
    privacyPrefix: 'By submitting, the information provided will be used to respond to your request. See the',
    privacyLink: 'Privacy Policy',
    submit: 'Send message',
    types: {
      support: { label: 'General support', subject: 'Support - Olha a Batida', hint: 'Describe your question or issue and, when useful, include your device, operating system and game version.' },
      bug: { label: 'Report a bug', subject: 'Bug - Olha a Batida', hint: 'Include your device, Android/iOS version, game version, where it happened, what happened and how to reproduce it.' },
      purchase_ads: { label: 'Purchases and ads', subject: 'Purchase or ad - Olha a Batida', hint: 'Describe the issue. Do not send passwords or full card details; include an order ID only when necessary.' },
      feedback: { label: 'Feedback and suggestions', subject: 'Feedback - Olha a Batida', hint: 'Share your idea, suggestion or impression of the game. Your message becomes a product signal, not an automatic implementation commitment.' },
      press_creator: { label: 'Press and creators', subject: 'Press and Creators - Realeiros Play', hint: 'Tell us your publication, channel or coverage context and what material or information you need.' },
      partnership: { label: 'Partnerships', subject: 'Partnership - Realeiros Play', hint: 'Present your organization, opportunity and the proposed partnership, publishing, licensing or commercial format.' },
      privacy: { label: 'Privacy and data', subject: 'Privacy and data - Realeiros Play', hint: 'Describe your privacy, data or deletion request and provide only the minimum information needed for review.' },
      general: { label: 'Other subject', subject: 'Website contact - Realeiros Play', hint: 'Tell us clearly how we can help.' },
    },
    runtime: {
      sending: 'Sending...',
      sendingMessage: 'Sending your message...',
      success: 'Message sent. Thanks for contacting us — we will reply to the email address provided.',
      error: 'We could not send your message right now. Try again in a moment or use the fallback email shown alongside the form.',
      submit: 'Send message',
    },
  },
  es: {
    subjectLabel: 'Asunto',
    name: 'Nombre',
    email: 'E-mail',
    organization: 'Empresa, medio o canal',
    optional: '(opcional)',
    message: 'Mensaje',
    botcheck: 'No rellenes este campo',
    privacyPrefix: 'Al enviar, los datos proporcionados se utilizarán para responder a tu solicitud. Consulta la',
    privacyLink: 'Política de Privacidad',
    submit: 'Enviar mensaje',
    types: {
      support: { label: 'Soporte general', subject: 'Soporte - Olha a Batida', hint: 'Describe tu duda o problema e indica, cuando sea útil, el dispositivo, sistema y versión del juego.' },
      bug: { label: 'Reportar un bug', subject: 'Bug - Olha a Batida', hint: 'Indica dispositivo, Android/iOS, versión del juego, dónde ocurrió, qué pasó y cómo reproducir el problema.' },
      purchase_ads: { label: 'Compras y anuncios', subject: 'Compra o anuncio - Olha a Batida', hint: 'Describe el problema. No envíes contraseñas ni datos completos de tarjeta; incluye el identificador del pedido solo cuando sea necesario.' },
      feedback: { label: 'Feedback y sugerencias', subject: 'Feedback - Olha a Batida', hint: 'Comparte tu idea, sugerencia o impresión sobre el juego. El envío se utiliza como señal para la evolución del producto.' },
      press_creator: { label: 'Prensa y creadores', subject: 'Prensa y Creadores - Realeiros Play', hint: 'Indica el medio, canal o contexto de la cobertura y el material o información que necesitas.' },
      partnership: { label: 'Colaboraciones', subject: 'Colaboración - Realeiros Play', hint: 'Presenta la organización, la oportunidad y el formato de colaboración, publishing, licencia o propuesta comercial.' },
      privacy: { label: 'Privacidad y datos', subject: 'Privacidad y datos - Realeiros Play', hint: 'Describe la solicitud de privacidad, datos o eliminación e incluye solo lo mínimo necesario para analizarla.' },
      general: { label: 'Otro asunto', subject: 'Contacto desde el sitio - Realeiros Play', hint: 'Cuéntanos de forma clara cómo podemos ayudarte.' },
    },
    runtime: {
      sending: 'Enviando...',
      sendingMessage: 'Enviando tu mensaje...',
      success: 'Mensaje enviado. Gracias por contactar — responderemos al e-mail indicado.',
      error: 'No pudimos enviar el mensaje ahora. Inténtalo de nuevo dentro de unos instantes o utiliza el e-mail alternativo indicado junto al formulario.',
      submit: 'Enviar mensaje',
    },
  },
}[locale];
const typeOrder = ['support', 'bug', 'purchase_ads', 'feedback', 'press_creator', 'partnership', 'privacy', 'general'];
---

<form id="contact-form" class="contact-form-card" action="https://api.web3forms.com/submit" method="POST" data-contact-form>
  <input type="hidden" name="access_key" value={accessKey} />
  <input type="hidden" name="subject" value={copy.types.general.subject} data-contact-subject />
  <input type="hidden" name="from_name" value="Realeiros Play - Site" />
  <input type="hidden" name="categoria" value={copy.types.general.label} data-contact-category-label />
  <input type="hidden" name="locale" value={locale} />

  <div class="contact-botcheck" aria-hidden="true">
    <label>{copy.botcheck}<input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
  </div>

  <div class="contact-form-field">
    <label for="contact-type">{copy.subjectLabel} <span aria-hidden="true">*</span></label>
    <select id="contact-type" name="contact_type" required data-contact-type-select>
      {typeOrder.map((key) => <option value={key} selected={key === 'general'}>{copy.types[key].label}</option>)}
    </select>
    <p class="contact-form-hint" data-contact-hint>{copy.types.general.hint}</p>
  </div>

  <div class="contact-form-row">
    <div class="contact-form-field">
      <label for="contact-name">{copy.name} <span aria-hidden="true">*</span></label>
      <input id="contact-name" type="text" name="name" autocomplete="name" maxlength="100" required />
    </div>
    <div class="contact-form-field">
      <label for="contact-email">{copy.email} <span aria-hidden="true">*</span></label>
      <input id="contact-email" type="email" name="email" autocomplete="email" maxlength="180" required />
    </div>
  </div>

  <div class="contact-form-field">
    <label for="contact-organization">{copy.organization} <small>{copy.optional}</small></label>
    <input id="contact-organization" type="text" name="organization" autocomplete="organization" maxlength="150" />
  </div>

  <div class="contact-form-field">
    <label for="contact-message">{copy.message} <span aria-hidden="true">*</span></label>
    <textarea id="contact-message" name="message" rows="8" maxlength="4000" required></textarea>
  </div>

  <p class="contact-form-privacy">
    {copy.privacyPrefix} <a href={privacyHref}>{copy.privacyLink}</a>.
  </p>

  <div class="contact-form-submit-row">
    <button class="button button-primary" type="submit" data-contact-submit><span data-contact-submit-label>{copy.submit}</span></button>
    <p class="contact-form-status" role="status" aria-live="polite" data-contact-status></p>
  </div>
</form>

<script is:inline define:vars={{ typeConfig: copy.types, runtimeCopy: copy.runtime }}>
  (() => {
    const form = document.querySelector('[data-contact-form]');
    if (!(form instanceof HTMLFormElement)) return;

    const typeSelect = form.querySelector('[data-contact-type-select]');
    const subjectInput = form.querySelector('[data-contact-subject]');
    const categoryLabelInput = form.querySelector('[data-contact-category-label]');
    const hint = form.querySelector('[data-contact-hint]');
    const submitButton = form.querySelector('[data-contact-submit]');
    const submitLabel = form.querySelector('[data-contact-submit-label]');
    const status = form.querySelector('[data-contact-status]');

    if (!(typeSelect instanceof HTMLSelectElement) || !(subjectInput instanceof HTMLInputElement) || !(categoryLabelInput instanceof HTMLInputElement) || !(hint instanceof HTMLElement) || !(submitButton instanceof HTMLButtonElement) || !(submitLabel instanceof HTMLElement) || !(status instanceof HTMLElement)) return;

    const aliases = {
      suporte: 'support', support: 'support', bug: 'bug', compra: 'purchase_ads', compras: 'purchase_ads', compra_anuncio: 'purchase_ads', purchase_ads: 'purchase_ads', feedback: 'feedback', imprensa: 'press_creator', press: 'press_creator', press_creator: 'press_creator', parceria: 'partnership', parcerias: 'partnership', partnership: 'partnership', privacidade: 'privacy', privacy: 'privacy', geral: 'general', outro: 'general', general: 'general',
    };

    let started = false;
    const normalizeType = (value) => {
      const normalized = String(value || '').trim().toLowerCase();
      return aliases[normalized] || (typeConfig[normalized] ? normalized : 'general');
    };

    const sendAnalytics = (eventName, contactType, extra = {}) => {
      if (window.__realeirosGa4Loaded !== true || typeof window.gtag !== 'function') return;
      window.gtag('event', eventName, { page_path: window.location.pathname, contact_type: contactType, ...extra });
    };

    const markStarted = () => {
      if (started) return;
      started = true;
      sendAnalytics('contact_form_start', normalizeType(typeSelect.value));
    };

    const setStatus = (message, state = '') => {
      status.textContent = message;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    const setType = (value, { updateUrl = false } = {}) => {
      const contactType = normalizeType(value);
      const config = typeConfig[contactType];
      typeSelect.value = contactType;
      subjectInput.value = config.subject;
      categoryLabelInput.value = config.label;
      hint.textContent = config.hint;
      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set('tipo', contactType);
        url.hash = 'formulario';
        window.history.replaceState({}, '', url);
      }
      return contactType;
    };

    const initialParams = new URLSearchParams(window.location.search);
    const initialType = setType(initialParams.get('tipo'));
    form.addEventListener('focusin', markStarted);
    typeSelect.addEventListener('change', () => { markStarted(); setType(typeSelect.value, { updateUrl: true }); setStatus(''); });

    document.querySelectorAll('a[data-contact-type]').forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;
      link.addEventListener('click', (event) => {
        let url;
        try { url = new URL(link.href, window.location.href); } catch { return; }
        if (url.origin !== window.location.origin || url.pathname !== window.location.pathname) return;
        event.preventDefault();
        setType(link.dataset.contactType || url.searchParams.get('tipo'), { updateUrl: true });
        document.getElementById('formulario')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
        typeSelect.focus({ preventScroll: true });
      });
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      markStarted();
      const contactType = setType(typeSelect.value);
      submitButton.disabled = true;
      submitLabel.textContent = runtimeCopy.sending;
      setStatus(runtimeCopy.sendingMessage);
      const payload = Object.fromEntries(new FormData(form).entries());

      try {
        const response = await fetch('https://api.web3forms.com/submit', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(payload) });
        const result = await response.json().catch(() => null);
        if (!response.ok || result?.success !== true) throw new Error(result?.message || `HTTP ${response.status}`);
        sendAnalytics('contact_form_submit', contactType);
        setStatus(runtimeCopy.success, 'success');
        form.reset();
        setType(contactType);
      } catch (error) {
        const errorType = error instanceof TypeError ? 'network' : 'provider';
        sendAnalytics('contact_form_error', contactType, { error_type: errorType });
        setStatus(runtimeCopy.error, 'error');
      } finally {
        submitButton.disabled = false;
        submitLabel.textContent = runtimeCopy.submit;
      }
    });

    if (initialType !== 'general') document.documentElement.dataset.contactPrefilled = 'true';
  })();
</script>
