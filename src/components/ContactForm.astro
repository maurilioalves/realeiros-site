---
interface Props {
  accessKey: string;
}

const { accessKey } = Astro.props;
---

<form
  id="contact-form"
  class="contact-form-card"
  action="https://api.web3forms.com/submit"
  method="POST"
  data-contact-form
>
  <input type="hidden" name="access_key" value={accessKey} />
  <input
    type="hidden"
    name="subject"
    value="Contato pelo site - Realeiros Play"
    data-contact-subject
  />
  <input type="hidden" name="from_name" value="Realeiros Play - Site" />
  <input type="hidden" name="categoria" value="Outro assunto" data-contact-category-label />

  <div class="contact-botcheck" aria-hidden="true">
    <label>
      Não preencha este campo
      <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" />
    </label>
  </div>

  <div class="contact-form-field">
    <label for="contact-type">Assunto <span aria-hidden="true">*</span></label>
    <select id="contact-type" name="contact_type" required data-contact-type-select>
      <option value="support">Suporte geral</option>
      <option value="bug">Reportar bug</option>
      <option value="purchase_ads">Compras e anúncios</option>
      <option value="feedback">Feedback e sugestões</option>
      <option value="press_creator">Imprensa e criadores</option>
      <option value="partnership">Parcerias</option>
      <option value="privacy">Privacidade e dados</option>
      <option value="general" selected>Outro assunto</option>
    </select>
    <p class="contact-form-hint" data-contact-hint>
      Conte de forma objetiva como podemos ajudar.
    </p>
  </div>

  <div class="contact-form-row">
    <div class="contact-form-field">
      <label for="contact-name">Nome <span aria-hidden="true">*</span></label>
      <input
        id="contact-name"
        type="text"
        name="name"
        autocomplete="name"
        maxlength="100"
        required
      />
    </div>

    <div class="contact-form-field">
      <label for="contact-email">E-mail <span aria-hidden="true">*</span></label>
      <input
        id="contact-email"
        type="email"
        name="email"
        autocomplete="email"
        maxlength="180"
        required
      />
    </div>
  </div>

  <div class="contact-form-field">
    <label for="contact-organization">Empresa, veículo ou canal <small>(opcional)</small></label>
    <input
      id="contact-organization"
      type="text"
      name="organization"
      autocomplete="organization"
      maxlength="150"
    />
  </div>

  <div class="contact-form-field">
    <label for="contact-message">Mensagem <span aria-hidden="true">*</span></label>
    <textarea
      id="contact-message"
      name="message"
      rows="8"
      maxlength="4000"
      required
    ></textarea>
  </div>

  <p class="contact-form-privacy">
    Ao enviar, os dados informados serão usados para responder à sua solicitação.
    Consulte a <a href="/privacidade">Política de Privacidade</a>.
  </p>

  <div class="contact-form-submit-row">
    <button class="button button-primary" type="submit" data-contact-submit>
      <span data-contact-submit-label>Enviar mensagem</span>
    </button>
    <p class="contact-form-status" role="status" aria-live="polite" data-contact-status></p>
  </div>
</form>

<script is:inline>
  (() => {
    const form = document.querySelector("[data-contact-form]");
    if (!(form instanceof HTMLFormElement)) return;

    const typeSelect = form.querySelector("[data-contact-type-select]");
    const subjectInput = form.querySelector("[data-contact-subject]");
    const categoryLabelInput = form.querySelector("[data-contact-category-label]");
    const hint = form.querySelector("[data-contact-hint]");
    const submitButton = form.querySelector("[data-contact-submit]");
    const submitLabel = form.querySelector("[data-contact-submit-label]");
    const status = form.querySelector("[data-contact-status]");

    if (
      !(typeSelect instanceof HTMLSelectElement) ||
      !(subjectInput instanceof HTMLInputElement) ||
      !(categoryLabelInput instanceof HTMLInputElement) ||
      !(hint instanceof HTMLElement) ||
      !(submitButton instanceof HTMLButtonElement) ||
      !(submitLabel instanceof HTMLElement) ||
      !(status instanceof HTMLElement)
    ) {
      return;
    }

    const typeConfig = {
      support: {
        label: "Suporte geral",
        subject: "Suporte - Olha a Batida",
        hint: "Explique sua dúvida ou problema e informe, quando ajudar, aparelho, sistema e versão do jogo.",
      },
      bug: {
        label: "Reportar bug",
        subject: "Bug - Olha a Batida",
        hint: "Informe aparelho, Android/iOS, versão do jogo, onde ocorreu, o que aconteceu e como reproduzir o problema.",
      },
      purchase_ads: {
        label: "Compras e anúncios",
        subject: "Compra ou anúncio - Olha a Batida",
        hint: "Descreva o problema. Não envie senha ou dados completos de cartão; informe identificador do pedido apenas quando necessário.",
      },
      feedback: {
        label: "Feedback e sugestões",
        subject: "Feedback - Olha a Batida",
        hint: "Conte sua ideia, sugestão ou percepção sobre o jogo. O envio entra como sinal para evolução do produto.",
      },
      press_creator: {
        label: "Imprensa e criadores",
        subject: "Imprensa e Criadores - Realeiros Play",
        hint: "Informe veículo, canal ou contexto da cobertura e o material ou informação de que precisa.",
      },
      partnership: {
        label: "Parcerias",
        subject: "Parceria - Realeiros Play",
        hint: "Apresente a organização, a oportunidade e o formato de parceria, publishing, licenciamento ou proposta comercial.",
      },
      privacy: {
        label: "Privacidade e dados",
        subject: "Privacidade e dados - Realeiros Play",
        hint: "Descreva a solicitação de privacidade, dados ou exclusão e informe apenas o mínimo necessário para análise.",
      },
      general: {
        label: "Outro assunto",
        subject: "Contato pelo site - Realeiros Play",
        hint: "Conte de forma objetiva como podemos ajudar.",
      },
    };

    const aliases = {
      suporte: "support",
      support: "support",
      bug: "bug",
      compra: "purchase_ads",
      compras: "purchase_ads",
      compra_anuncio: "purchase_ads",
      purchase_ads: "purchase_ads",
      feedback: "feedback",
      imprensa: "press_creator",
      press: "press_creator",
      press_creator: "press_creator",
      parceria: "partnership",
      parcerias: "partnership",
      partnership: "partnership",
      privacidade: "privacy",
      privacy: "privacy",
      geral: "general",
      outro: "general",
      general: "general",
    };

    let started = false;

    const normalizeType = (value) => {
      const normalized = String(value || "").trim().toLowerCase();
      return aliases[normalized] || (typeConfig[normalized] ? normalized : "general");
    };

    const sendAnalytics = (eventName, contactType, extra = {}) => {
      if (
        window.__realeirosGa4Loaded !== true ||
        typeof window.gtag !== "function"
      ) {
        return;
      }

      window.gtag("event", eventName, {
        page_path: window.location.pathname,
        contact_type: contactType,
        ...extra,
      });
    };

    const markStarted = () => {
      if (started) return;
      started = true;
      sendAnalytics("contact_form_start", normalizeType(typeSelect.value));
    };

    const setStatus = (message, state = "") => {
      status.textContent = message;
      if (state) {
        status.dataset.state = state;
      } else {
        delete status.dataset.state;
      }
    };

    const setType = (value, { updateUrl = false } = {}) => {
      const contactType = normalizeType(value);
      const config = typeConfig[contactType];

      typeSelect.value = contactType;
      subjectInput.value = config.subject;
      categoryLabelInput.value = config.label;
      hint.textContent = config.hint;

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.set("tipo", contactType);
        url.hash = "formulario";
        window.history.replaceState({}, "", url);
      }

      return contactType;
    };

    const initialParams = new URLSearchParams(window.location.search);
    const initialType = setType(initialParams.get("tipo"));

    form.addEventListener("focusin", markStarted);

    typeSelect.addEventListener("change", () => {
      markStarted();
      setType(typeSelect.value, { updateUrl: true });
      setStatus("");
    });

    document.querySelectorAll("a[data-contact-type]").forEach((link) => {
      if (!(link instanceof HTMLAnchorElement)) return;

      link.addEventListener("click", (event) => {
        let url;
        try {
          url = new URL(link.href, window.location.href);
        } catch {
          return;
        }

        if (url.origin !== window.location.origin || url.pathname !== window.location.pathname) {
          return;
        }

        event.preventDefault();
        setType(link.dataset.contactType || url.searchParams.get("tipo"), { updateUrl: true });
        document.getElementById("formulario")?.scrollIntoView({ behavior: "smooth", block: "start" });
        typeSelect.focus({ preventScroll: true });
      });
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      markStarted();

      const contactType = setType(typeSelect.value);
      submitButton.disabled = true;
      submitLabel.textContent = "Enviando...";
      setStatus("Enviando sua mensagem...");

      const payload = Object.fromEntries(new FormData(form).entries());

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
            Accept: "application/json",
          },
          body: JSON.stringify(payload),
        });

        const result = await response.json().catch(() => null);

        if (!response.ok || result?.success !== true) {
          throw new Error(result?.message || `HTTP ${response.status}`);
        }

        sendAnalytics("contact_form_submit", contactType);
        setStatus("Mensagem enviada. Obrigado pelo contato — responderemos pelo e-mail informado.", "success");

        form.reset();
        setType(contactType);
      } catch (error) {
        const errorType = error instanceof TypeError ? "network" : "provider";
        sendAnalytics("contact_form_error", contactType, { error_type: errorType });
        setStatus(
          "Não foi possível enviar agora. Tente novamente em alguns instantes ou use o e-mail de fallback informado ao lado.",
          "error",
        );
      } finally {
        submitButton.disabled = false;
        submitLabel.textContent = "Enviar mensagem";
      }
    });

    if (initialType !== "general") {
      document.documentElement.dataset.contactPrefilled = "true";
    }
  })();
</script>
