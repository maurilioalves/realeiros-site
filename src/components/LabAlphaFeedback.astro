---
interface Props {
  accessKey: string;
}
const { accessKey } = Astro.props;
---

<button class="lab-feedback-trigger" type="button" data-lab-feedback-open aria-haspopup="dialog">
  <span class="lab-feedback-trigger-icon" aria-hidden="true">★</span>
  <span>Enviar feedback</span>
</button>
<p class="lab-feedback-gate-note" data-feedback-gate-note hidden></p>

<dialog class="lab-feedback-dialog" data-lab-feedback-dialog aria-labelledby="lab-feedback-title">
  <div class="lab-feedback-panel">
    <div class="lab-feedback-header">
      <div>
        <p class="lab-feedback-kicker">PUBLIC ALPHA</p>
        <h1 id="lab-feedback-title">Ajude a melhorar o Lança a Braba</h1>
        <p>Leva cerca de 1 minuto. Seu feedback entra diretamente na avaliação desta alpha.</p>
      </div>
      <button class="lab-feedback-close" type="button" data-lab-feedback-close aria-label="Fechar feedback">×</button>
    </div>

    <form class="lab-feedback-form" data-lab-feedback-form>
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" value="Feedback Public Alpha - Lança a Braba" />
      <input type="hidden" name="from_name" value="Lança a Braba - Public Alpha" />
      <input type="hidden" name="produto" value="Lança a Braba" />
      <input type="hidden" name="fase" value="Public Alpha" />
      <input type="hidden" name="alpha_version" value="0.1.0-alpha.1" />
      <input type="hidden" name="viewport" data-feedback-viewport />
      <input type="hidden" name="touch_capable" data-feedback-touch />
      <input type="hidden" name="platform" data-feedback-platform />

      <div class="lab-feedback-botcheck" aria-hidden="true">
        <label>Não preencha este campo <input type="checkbox" name="botcheck" tabindex="-1" autocomplete="off" /></label>
      </div>

      <fieldset class="lab-feedback-field lab-star-field" data-star-rating>
        <legend>Quanto você se divertiu?</legend>
        <p class="lab-feedback-hint">1 = nada divertido · 5 = muito divertido</p>
        <div class="lab-stars" role="radiogroup" aria-label="Nota de diversão de 1 a 5 estrelas">
          {Array.from({ length: 5 }, (_, i) => i + 1).map((value) => (
            <>
              <input class="lab-star-input" type="radio" id={`fun-${value}`} name="fun_rating" value={value} required={value === 1} />
              <label class="lab-star" for={`fun-${value}`} data-star-value={value} aria-label={`${value} ${value === 1 ? 'estrela' : 'estrelas'}`}>★</label>
            </>
          ))}
        </div>
      </fieldset>

      <fieldset class="lab-feedback-field lab-star-field" data-star-rating>
        <legend>Foi fácil entender como jogar?</legend>
        <p class="lab-feedback-hint">1 = muito confuso · 5 = muito claro</p>
        <div class="lab-stars" role="radiogroup" aria-label="Nota de clareza de 1 a 5 estrelas">
          {Array.from({ length: 5 }, (_, i) => i + 1).map((value) => (
            <>
              <input class="lab-star-input" type="radio" id={`clarity-${value}`} name="clarity_rating" value={value} required={value === 1} />
              <label class="lab-star" for={`clarity-${value}`} data-star-value={value} aria-label={`${value} ${value === 1 ? 'estrela' : 'estrelas'}`}>★</label>
            </>
          ))}
        </div>
      </fieldset>

      <fieldset class="lab-feedback-field">
        <legend>Como você achou a dificuldade?</legend>
        <div class="lab-choice-row">
          <label><input type="radio" name="difficulty" value="facil" required /><span>Fácil</span></label>
          <label><input type="radio" name="difficulty" value="equilibrada" /><span>Equilibrada</span></label>
          <label><input type="radio" name="difficulty" value="dificil" /><span>Difícil</span></label>
        </div>
      </fieldset>

      <fieldset class="lab-feedback-field">
        <legend>Você jogaria novamente?</legend>
        <div class="lab-choice-row">
          <label><input type="radio" name="replay_intent" value="sim" required /><span>Sim</span></label>
          <label><input type="radio" name="replay_intent" value="talvez" /><span>Talvez</span></label>
          <label><input type="radio" name="replay_intent" value="nao" /><span>Não</span></label>
        </div>
      </fieldset>

      <p class="lab-feedback-quality-note">Para o envio contar como feedback da alpha, escreva pelo menos uma frase curta em um dos campos abaixo.</p>

      <label class="lab-feedback-field">
        <span>O que você mais gostou? <small>(opcional)</small></span>
        <textarea name="liked_most" rows="3" maxlength="1000" placeholder="Pode ser uma mecânica, sensação, visual, som ou qualquer outro ponto."></textarea>
      </label>

      <label class="lab-feedback-field">
        <span>O que mais te incomodou ou confundiu? <small>(opcional)</small></span>
        <textarea name="friction" rows="3" maxlength="1000" placeholder="Conte onde você travou, ficou em dúvida ou sentiu alguma frustração."></textarea>
      </label>

      <fieldset class="lab-feedback-field">
        <legend>Encontrou algum bug?</legend>
        <div class="lab-choice-row lab-choice-row-short">
          <label><input type="radio" name="bug_reported" value="sim" required data-bug-answer /><span>Sim</span></label>
          <label><input type="radio" name="bug_reported" value="nao" data-bug-answer /><span>Não</span></label>
        </div>
      </fieldset>

      <label class="lab-feedback-field lab-bug-details" data-bug-details hidden>
        <span>Descreva o bug <small>(opcional)</small></span>
        <textarea name="bug_details" rows="3" maxlength="1200" placeholder="O que aconteceu e, se souber, como reproduzir?"></textarea>
      </label>

      <div class="lab-feedback-identity">
        <label class="lab-feedback-field">
          <span>Nome <small>(opcional)</small></span>
          <input type="text" name="name" maxlength="100" autocomplete="name" />
        </label>
        <label class="lab-feedback-field">
          <span>E-mail <small>(opcional)</small></span>
          <input type="email" name="email" maxlength="180" autocomplete="email" />
        </label>
      </div>

      <div class="lab-feedback-captcha-wrap">
        <div class="h-captcha" data-captcha="true" data-theme="dark"></div>
      </div>

      <p class="lab-feedback-privacy">Nome e e-mail são opcionais. Se informados, serão usados apenas para eventual contato sobre este feedback. Consulte a <a href="/privacidade" target="_blank" rel="noreferrer">Política de Privacidade</a>.</p>

      <div class="lab-feedback-actions">
        <button class="lab-feedback-submit" type="submit" data-feedback-submit><span data-feedback-submit-label>Enviar feedback</span></button>
        <p class="lab-feedback-status" role="status" aria-live="polite" data-feedback-status></p>
      </div>
    </form>
  </div>
</dialog>

<script is:inline src="https://web3forms.com/client/script.js" async defer></script>

<script is:inline>
  (() => {
    const SAVE_KEY = 'LANCA_A_BRABA_SAVE_V1';
    const HISTORY_KEY = 'LAB_ALPHA_FEEDBACK_HISTORY_V1';
    const COOLDOWN_MS = 30 * 60 * 1000;
    const DAILY_WINDOW_MS = 24 * 60 * 60 * 1000;
    const DUPLICATE_WINDOW_MS = 7 * DAILY_WINDOW_MS;
    const DAILY_LIMIT = 3;

    const dialog = document.querySelector('[data-lab-feedback-dialog]');
    const openButton = document.querySelector('[data-lab-feedback-open]');
    const closeButton = document.querySelector('[data-lab-feedback-close]');
    const form = document.querySelector('[data-lab-feedback-form]');
    const gateNote = document.querySelector('[data-feedback-gate-note]');

    if (!(dialog instanceof HTMLDialogElement) || !(openButton instanceof HTMLButtonElement) || !(closeButton instanceof HTMLButtonElement) || !(form instanceof HTMLFormElement)) return;

    const submitButton = form.querySelector('[data-feedback-submit]');
    const submitLabel = form.querySelector('[data-feedback-submit-label]');
    const status = form.querySelector('[data-feedback-status]');
    const viewportInput = form.querySelector('[data-feedback-viewport]');
    const touchInput = form.querySelector('[data-feedback-touch]');
    const platformInput = form.querySelector('[data-feedback-platform]');
    const bugDetails = form.querySelector('[data-bug-details]');
    let feedbackStarted = false;
    let gateTimer = 0;

    const analytics = (name, extra = {}) => {
      if (window.__realeirosGa4Loaded !== true || typeof window.gtag !== 'function') return;
      window.gtag('event', name, { page_path: window.location.pathname, product: 'lanca_a_braba', phase: 'public_alpha', ...extra });
    };

    const setStatus = (message, state = '') => {
      if (!(status instanceof HTMLElement)) return;
      status.textContent = message;
      if (state) status.dataset.state = state;
      else delete status.dataset.state;
    };

    const showGateNote = (message) => {
      if (!(gateNote instanceof HTMLElement)) return;
      gateNote.textContent = message;
      gateNote.hidden = false;
      window.clearTimeout(gateTimer);
      gateTimer = window.setTimeout(() => { gateNote.hidden = true; }, 4200);
    };

    const setMetadata = () => {
      if (viewportInput instanceof HTMLInputElement) viewportInput.value = `${window.innerWidth}x${window.innerHeight}`;
      if (touchInput instanceof HTMLInputElement) touchInput.value = navigator.maxTouchPoints > 0 ? 'sim' : 'nao';
      if (platformInput instanceof HTMLInputElement) platformInput.value = navigator.userAgentData?.platform || navigator.platform || 'unknown';
    };

    const hasRealGameplay = () => {
      try {
        const raw = localStorage.getItem(SAVE_KEY);
        if (!raw) return false;
        const parsed = JSON.parse(raw);
        return Number(parsed?.stats?.totalPlays || 0) > 0;
      } catch {
        return false;
      }
    };

    const readHistory = () => {
      try {
        const raw = localStorage.getItem(HISTORY_KEY);
        const parsed = raw ? JSON.parse(raw) : [];
        return Array.isArray(parsed) ? parsed.filter((item) => item && Number.isFinite(item.at) && typeof item.hash === 'string') : [];
      } catch {
        return [];
      }
    };

    const writeHistory = (history) => {
      try { localStorage.setItem(HISTORY_KEY, JSON.stringify(history.slice(-12))); } catch {}
    };

    const getRateLimitBlock = () => {
      const now = Date.now();
      const history = readHistory().filter((item) => now - item.at < DUPLICATE_WINDOW_MS);
      writeHistory(history);
      const last = history.at(-1);
      if (last && now - last.at < COOLDOWN_MS) return 'cooldown';
      if (history.filter((item) => now - item.at < DAILY_WINDOW_MS).length >= DAILY_LIMIT) return 'daily_limit';
      return '';
    };

    const normalizeText = (value) => String(value || '').trim().replace(/\s+/g, ' ');
    const isMeaningfulText = (value) => {
      const text = normalizeText(value);
      if (text.length < 15) return false;
      const words = text.match(/[A-Za-zÀ-ÿ]{2,}/g) || [];
      if (words.length < 2) return false;
      return new Set(text.toLowerCase().replace(/[^a-zà-ÿ0-9]/g, '')).size >= 5;
    };

    const fingerprint = async (data) => {
      const source = [
        data.get('fun_rating'), data.get('clarity_rating'), data.get('difficulty'), data.get('replay_intent'),
        normalizeText(data.get('liked_most')).toLowerCase(), normalizeText(data.get('friction')).toLowerCase(),
        data.get('bug_reported'), normalizeText(data.get('bug_details')).toLowerCase(),
      ].join('|');
      if (crypto?.subtle) {
        const digest = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(source));
        return Array.from(new Uint8Array(digest)).map((b) => b.toString(16).padStart(2, '0')).join('');
      }
      let hash = 5381;
      for (let i = 0; i < source.length; i++) hash = ((hash << 5) + hash) ^ source.charCodeAt(i);
      return `fallback-${hash >>> 0}`;
    };

    const block = (reason, message, gate = false) => {
      analytics('lab_feedback_blocked', { reason });
      if (gate) showGateNote(message);
      else setStatus(message, 'error');
    };

    form.querySelectorAll('[data-star-rating]').forEach((group) => {
      const inputs = Array.from(group.querySelectorAll('input[type="radio"]'));
      const stars = Array.from(group.querySelectorAll('[data-star-value]'));
      const selectedValue = () => {
        const selected = inputs.find((input) => input instanceof HTMLInputElement && input.checked);
        return selected instanceof HTMLInputElement ? Number(selected.value) : 0;
      };
      const paint = (value) => stars.forEach((star) => star.classList.toggle('is-active', Number(star.getAttribute('data-star-value') || 0) <= value));
      inputs.forEach((input) => input.addEventListener('change', () => paint(selectedValue())));
      stars.forEach((star) => star.addEventListener('mouseenter', () => paint(Number(star.getAttribute('data-star-value') || 0))));
      group.addEventListener('mouseleave', () => paint(selectedValue()));
    });

    form.querySelectorAll('[data-bug-answer]').forEach((input) => {
      input.addEventListener('change', () => {
        if (!(bugDetails instanceof HTMLElement)) return;
        const selected = form.querySelector('input[name="bug_reported"]:checked');
        bugDetails.hidden = !(selected instanceof HTMLInputElement && selected.value === 'sim');
      });
    });

    const markStarted = () => {
      if (feedbackStarted) return;
      feedbackStarted = true;
      analytics('lab_feedback_start');
    };

    openButton.addEventListener('click', () => {
      if (!hasRealGameplay()) {
        block('no_gameplay', 'Jogue pelo menos uma jogada antes de enviar feedback.', true);
        return;
      }
      const rateBlock = getRateLimitBlock();
      if (rateBlock === 'cooldown') {
        block(rateBlock, 'Seu feedback anterior já foi recebido. Aguarde um pouco antes de enviar outro.', true);
        return;
      }
      if (rateBlock === 'daily_limit') {
        block(rateBlock, 'Limite de feedbacks deste dispositivo atingido por hoje.', true);
        return;
      }
      feedbackStarted = false;
      setMetadata();
      setStatus('');
      analytics('lab_feedback_open');
      dialog.showModal();
    });

    closeButton.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => { if (event.target === dialog) dialog.close(); });
    form.addEventListener('focusin', markStarted);
    form.addEventListener('change', markStarted);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      markStarted();
      setMetadata();
      if (!(submitButton instanceof HTMLButtonElement) || !(submitLabel instanceof HTMLElement)) return;
      if (!form.reportValidity()) return;

      if (!hasRealGameplay()) {
        block('no_gameplay', 'Não foi possível confirmar gameplay antes do envio. Jogue ao menos uma jogada e tente novamente.');
        return;
      }

      const rateBlock = getRateLimitBlock();
      if (rateBlock) {
        block(rateBlock, rateBlock === 'cooldown' ? 'Aguarde 30 minutos antes de enviar outro feedback.' : 'Limite de 3 feedbacks em 24 horas atingido neste dispositivo.');
        return;
      }

      const data = new FormData(form);
      const liked = data.get('liked_most');
      const friction = data.get('friction');
      const bug = data.get('bug_details');
      if (![liked, friction, bug].some(isMeaningfulText)) {
        block('low_quality', 'Escreva pelo menos uma frase curta e compreensível em um dos campos de comentário.');
        return;
      }

      const captchaToken = normalizeText(data.get('h-captcha-response'));
      if (!captchaToken) {
        block('captcha', 'Confirme o hCaptcha antes de enviar.');
        return;
      }

      const hash = await fingerprint(data);
      const now = Date.now();
      const history = readHistory().filter((item) => now - item.at < DUPLICATE_WINDOW_MS);
      if (history.some((item) => item.hash === hash)) {
        block('duplicate', 'Este mesmo feedback já foi enviado anteriormente.');
        return;
      }

      submitButton.disabled = true;
      submitLabel.textContent = 'Enviando...';
      setStatus('Enviando seu feedback...');

      try {
        const payload = Object.fromEntries(data.entries());
        const response = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => null);
        if (!response.ok || result?.success !== true) throw new Error(result?.message || `HTTP ${response.status}`);

        history.push({ at: now, hash });
        writeHistory(history);
        analytics('lab_feedback_submit', {
          fun_rating: Number(data.get('fun_rating') || 0),
          clarity_rating: Number(data.get('clarity_rating') || 0),
          difficulty: String(data.get('difficulty') || ''),
          replay_intent: String(data.get('replay_intent') || ''),
          bug_reported: String(data.get('bug_reported') || ''),
        });

        form.reset();
        form.querySelectorAll('[data-star-value]').forEach((star) => star.classList.remove('is-active'));
        if (bugDetails instanceof HTMLElement) bugDetails.hidden = true;
        window.hcaptcha?.reset?.();
        setStatus('Feedback enviado. Obrigado por participar da Public Alpha!', 'success');
      } catch (error) {
        analytics('lab_feedback_error', { error_type: error instanceof TypeError ? 'network' : 'provider' });
        setStatus('Não foi possível enviar agora. Tente novamente em alguns instantes.', 'error');
      } finally {
        submitButton.disabled = false;
        submitLabel.textContent = 'Enviar feedback';
      }
    });
  })();
</script>

<style is:global>
  .lab-feedback-trigger{position:fixed;right:max(14px,env(safe-area-inset-right));bottom:max(16px,env(safe-area-inset-bottom));z-index:2147483600;isolation:isolate;display:inline-flex;align-items:center;gap:8px;min-height:46px;padding:0 17px;overflow:hidden;border:1px solid rgba(255,237,77,.95);border-radius:999px;background:linear-gradient(135deg,#f5e61b 0%,#ffd84a 52%,#f5e61b 100%);color:#07101f;font:900 13px/1 system-ui,sans-serif;cursor:pointer;box-shadow:0 0 0 1px rgba(245,230,27,.18),0 0 18px rgba(245,230,27,.68),0 7px 26px rgba(0,0,0,.42);animation:lab-feedback-pulse 2.3s ease-in-out infinite;transition:transform .18s ease,box-shadow .18s ease}
  .lab-feedback-trigger::after{content:"";position:absolute;z-index:-1;top:-95%;left:-48%;width:22%;height:290%;transform:rotate(18deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.98),transparent);filter:blur(1px);animation:lab-feedback-sweep 2.8s ease-in-out infinite;pointer-events:none}
