  @keyframes lab-feedback-sweep{0%,18%{left:-48%;opacity:0}28%{opacity:1}68%{opacity:1}82%,100%{left:132%;opacity:0}}
  .lab-feedback-dialog{width:min(680px,calc(100vw - 24px));max-height:min(88dvh,820px);margin:auto;padding:0;overflow:hidden;border:1px solid rgba(245,230,27,.38);border-radius:22px;background:#081226;color:#f5f0e6;box-shadow:0 30px 90px rgba(0,0,0,.72),0 0 40px rgba(245,230,27,.12)}.lab-feedback-dialog::backdrop{background:rgba(2,6,14,.78);backdrop-filter:blur(6px)}.lab-feedback-panel{max-height:min(88dvh,820px);overflow-y:auto;overscroll-behavior:contain}
  .lab-feedback-header{position:sticky;top:0;z-index:3;display:flex;justify-content:space-between;gap:16px;padding:22px 22px 18px;border-bottom:1px solid rgba(255,255,255,.09);background:rgba(8,18,38,.96);backdrop-filter:blur(12px)}.lab-feedback-header h1{margin:3px 0 7px;color:#fff;font:900 clamp(22px,5vw,30px)/1.05 system-ui,sans-serif}.lab-feedback-header p:not(.lab-feedback-kicker){margin:0;color:#aebbd0;font:500 13px/1.45 system-ui,sans-serif}.lab-feedback-kicker{margin:0;color:#f5e61b;font:900 10px/1 system-ui,sans-serif;letter-spacing:.16em}.lab-feedback-close{flex:0 0 38px;width:38px;height:38px;border:1px solid rgba(255,255,255,.14);border-radius:50%;background:rgba(255,255,255,.06);color:#fff;font:300 27px/1 system-ui,sans-serif;cursor:pointer}
