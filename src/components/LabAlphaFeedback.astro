  .lab-feedback-trigger-icon{font-size:17px}.lab-feedback-gate-note{position:fixed;right:max(14px,env(safe-area-inset-right));bottom:max(70px,calc(env(safe-area-inset-bottom) + 68px));z-index:2147483601;max-width:min(330px,calc(100vw - 28px));margin:0;padding:9px 11px;border:1px solid rgba(245,230,27,.32);border-radius:10px;background:rgba(5,11,22,.96);color:#f5f0e6;font:700 11px/1.4 system-ui,sans-serif;box-shadow:0 8px 26px rgba(0,0,0,.45)}
