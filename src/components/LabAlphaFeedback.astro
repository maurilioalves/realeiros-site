  .lab-stars{display:flex;align-items:center;gap:clamp(7px,2.4vw,13px);width:fit-content}.lab-star-input{position:absolute;width:1px;height:1px;opacity:0;pointer-events:none}.lab-star{color:#34435c;font-size:clamp(34px,9vw,46px);line-height:1;cursor:pointer;filter:drop-shadow(0 2px 3px rgba(0,0,0,.35));transition:color .12s ease,transform .12s ease,filter .12s ease}.lab-star.is-active{color:#f5e61b;transform:translateY(-1px) scale(1.06);filter:drop-shadow(0 0 8px rgba(245,230,27,.52))}.lab-star-input:focus-visible+.lab-star{outline:2px solid #fff;outline-offset:4px;border-radius:4px}
