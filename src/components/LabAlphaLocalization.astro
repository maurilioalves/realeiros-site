        close: 'Cerrar feedback',
        kicker: 'PUBLIC ALPHA',
        title: 'Ayúdanos a mejorar Lança a Braba',
        intro: 'Tarda cerca de 1 minuto. Tu feedback entra directamente en la evaluación de esta alpha.',
        funLegend: '¿Cuánto te divertiste?',
        funHint: '1 = nada divertido · 5 = muy divertido',
        funAria: 'Valoración de diversión de 1 a 5 estrellas',
        clarityLegend: '¿Fue fácil entender cómo jugar?',
        clarityHint: '1 = muy confuso · 5 = muy claro',
        clarityAria: 'Valoración de claridad de 1 a 5 estrellas',
        star: 'estrella',
        stars: 'estrellas',
        difficultyLegend: '¿Cómo sentiste la dificultad?',
        difficulty: ['Fácil', 'Equilibrada', 'Difícil'],
        replayLegend: '¿Volverías a jugar?',
        replay: ['Sí', 'Tal vez', 'No'],
        quality: 'Para que el envío cuente como feedback de la alpha, escribe al menos una frase corta en uno de los campos siguientes.',
        liked: '¿Qué fue lo que más te gustó?',
        likedPlaceholder: 'Puede ser una mecánica, sensación, apartado visual, sonido o cualquier otro punto.',
        friction: '¿Qué fue lo que más te molestó o confundió?',
        frictionPlaceholder: 'Cuéntanos dónde te atascaste, dudaste o sentiste frustración.',
        optional: '(opcional)',
        bugLegend: '¿Encontraste algún bug?',
        bugYes: 'Sí',
        bugNo: 'No',
        bugDetails: 'Describe el bug',
        bugPlaceholder: '¿Qué ocurrió y, si lo sabes, cómo podemos reproducirlo?',
        name: 'Nombre',
        email: 'E-mail',
        privacyPrefix: 'El nombre y el e-mail son opcionales. Si los proporcionas, solo se usarán para un posible contacto sobre este feedback. Consulta la ',
        privacyLink: 'Política de Privacidad',
        submit: 'Enviar feedback',
        sending: 'Enviando...',
        statusMap: {
          'Jogue pelo menos uma jogada antes de enviar feedback.': 'Juega al menos una jugada antes de enviar feedback.',
          'Seu feedback anterior já foi recebido. Aguarde um pouco antes de enviar outro.': 'Ya recibimos tu feedback anterior. Espera un poco antes de enviar otro.',
          'Limite de feedbacks deste dispositivo atingido por hoje.': 'Este dispositivo ha alcanzado el límite de feedback de hoy.',
          'Não foi possível confirmar gameplay antes do envio. Jogue ao menos uma jogada e tente novamente.': 'No pudimos confirmar gameplay antes del envío. Juega al menos una jugada e inténtalo de nuevo.',
          'Aguarde 30 minutos antes de enviar outro feedback.': 'Espera 30 minutos antes de enviar otro feedback.',
          'Limite de 3 feedbacks em 24 horas atingido neste dispositivo.': 'Este dispositivo ha alcanzado el límite de 3 envíos de feedback en 24 horas.',
          'Escreva pelo menos uma frase curta e compreensível em um dos campos de comentário.': 'Escribe al menos una frase corta y comprensible en uno de los campos de comentario.',
          'Confirme o hCaptcha antes de enviar.': 'Completa el hCaptcha antes de enviar.',
          'Este mesmo feedback já foi enviado anteriormente.': 'Este mismo feedback ya se envió anteriormente.',
          'Enviando seu feedback...': 'Enviando tu feedback...',
          'Feedback enviado. Obrigado por participar da Public Alpha!': 'Feedback enviado. ¡Gracias por participar en la Public Alpha!',
          'Não foi possível enviar agora. Tente novamente em alguns instantes.': 'No se pudo enviar ahora. Inténtalo de nuevo dentro de unos instantes.',
        },
      },
    };

    const detectLocale = () => {
      try {
        const stored = localStorage.getItem(LOCALE_KEY);
        if (stored === 'pt-BR' || stored === 'en-US' || stored === 'es-ES') return stored;
      } catch {}
      const languages = navigator.languages?.length ? navigator.languages : [navigator.language || ''];
      for (const language of languages) {
        const normalized = String(language).toLowerCase();
        if (normalized.startsWith('pt')) return 'pt-BR';
        if (normalized.startsWith('es')) return 'es-ES';
        if (normalized.startsWith('en')) return 'en-US';
      }
      return 'en-US';
    };

    let locale = detectLocale();
    let dictionary = copy[locale];

    const setText = (selector, value) => {
      const node = document.querySelector(selector);
      if (node instanceof HTMLElement) node.textContent = value;
    };

    const setLabelText = (inputName, value) => {
      const input = document.querySelector(`[name="${inputName}"]`);
      const label = input?.closest('label');
      const span = label?.querySelector(':scope > span');
      if (!(span instanceof HTMLElement)) return;
      const small = span.querySelector('small');
      span.firstChild && (span.firstChild.textContent = `${value} `);
      if (small instanceof HTMLElement) small.textContent = dictionary.optional;
    };

    const applyStaticCopy = () => {
      dictionary = copy[locale];
      document.documentElement.lang = locale;
      const description = document.querySelector('meta[name="description"]');
      if (description instanceof HTMLMetaElement) description.content = dictionary.description;
      const frame = document.querySelector('[data-lab-game-frame]');
      if (frame instanceof HTMLIFrameElement) frame.title = dictionary.iframeTitle;

      const triggerText = document.querySelector('[data-lab-feedback-open] span:last-child');
      if (triggerText instanceof HTMLElement) triggerText.textContent = dictionary.trigger;
      const close = document.querySelector('[data-lab-feedback-close]');
      if (close instanceof HTMLButtonElement) close.setAttribute('aria-label', dictionary.close);

      setText('.lab-feedback-kicker', dictionary.kicker);
      setText('#lab-feedback-title', dictionary.title);
      setText('.lab-feedback-header p:not(.lab-feedback-kicker)', dictionary.intro);

      const fun = document.querySelector('input[name="fun_rating"]')?.closest('fieldset');
      const clarity = document.querySelector('input[name="clarity_rating"]')?.closest('fieldset');
      const difficulty = document.querySelector('input[name="difficulty"]')?.closest('fieldset');
      const replay = document.querySelector('input[name="replay_intent"]')?.closest('fieldset');
      const bug = document.querySelector('input[name="bug_reported"]')?.closest('fieldset');

      if (fun) {
        const legend = fun.querySelector('legend');
        const hint = fun.querySelector('.lab-feedback-hint');
        const group = fun.querySelector('[role="radiogroup"]');
        if (legend) legend.textContent = dictionary.funLegend;
        if (hint) hint.textContent = dictionary.funHint;
        group?.setAttribute('aria-label', dictionary.funAria);
      }
      if (clarity) {
        const legend = clarity.querySelector('legend');
        const hint = clarity.querySelector('.lab-feedback-hint');
        const group = clarity.querySelector('[role="radiogroup"]');
        if (legend) legend.textContent = dictionary.clarityLegend;
        if (hint) hint.textContent = dictionary.clarityHint;
        group?.setAttribute('aria-label', dictionary.clarityAria);
      }

      document.querySelectorAll('.lab-star[data-star-value]').forEach((star) => {
        const value = Number(star.getAttribute('data-star-value') || 0);
        star.setAttribute('aria-label', `${value} ${value === 1 ? dictionary.star : dictionary.stars}`);
      });

      if (difficulty) {
        const legend = difficulty.querySelector('legend');
        if (legend) legend.textContent = dictionary.difficultyLegend;
        difficulty.querySelectorAll('.lab-choice-row span').forEach((span, index) => {
          if (dictionary.difficulty[index]) span.textContent = dictionary.difficulty[index];
        });
      }
      if (replay) {
        const legend = replay.querySelector('legend');
        if (legend) legend.textContent = dictionary.replayLegend;
        replay.querySelectorAll('.lab-choice-row span').forEach((span, index) => {
          if (dictionary.replay[index]) span.textContent = dictionary.replay[index];
        });
      }

      setText('.lab-feedback-quality-note', dictionary.quality);
      setLabelText('liked_most', dictionary.liked);
      setLabelText('friction', dictionary.friction);
      const liked = document.querySelector('textarea[name="liked_most"]');
      const friction = document.querySelector('textarea[name="friction"]');
      if (liked instanceof HTMLTextAreaElement) liked.placeholder = dictionary.likedPlaceholder;
      if (friction instanceof HTMLTextAreaElement) friction.placeholder = dictionary.frictionPlaceholder;

      if (bug) {
        const legend = bug.querySelector('legend');
        if (legend) legend.textContent = dictionary.bugLegend;
        const spans = bug.querySelectorAll('.lab-choice-row span');
        if (spans[0]) spans[0].textContent = dictionary.bugYes;
        if (spans[1]) spans[1].textContent = dictionary.bugNo;
      }
      setLabelText('bug_details', dictionary.bugDetails);
      const bugDetails = document.querySelector('textarea[name="bug_details"]');
      if (bugDetails instanceof HTMLTextAreaElement) bugDetails.placeholder = dictionary.bugPlaceholder;

      setLabelText('name', dictionary.name);
      setLabelText('email', dictionary.email);

      const privacy = document.querySelector('.lab-feedback-privacy');
      if (privacy instanceof HTMLElement) {
        const link = privacy.querySelector('a');
        privacy.textContent = dictionary.privacyPrefix;
        if (link instanceof HTMLAnchorElement) {
          link.textContent = dictionary.privacyLink;
          privacy.append(link, '.');
        }
      }

      const submitLabel = document.querySelector('[data-feedback-submit-label]');
      if (submitLabel instanceof HTMLElement && submitLabel.textContent !== dictionary.sending) {
        submitLabel.textContent = dictionary.submit;
      }

      const form = document.querySelector('[data-lab-feedback-form]');
      if (form instanceof HTMLFormElement) {
        let localeInput = form.querySelector('input[name="locale"]');
        if (!(localeInput instanceof HTMLInputElement)) {
          localeInput = document.createElement('input');
          localeInput.type = 'hidden';
          localeInput.name = 'locale';
          form.append(localeInput);
        }
        localeInput.value = locale;
      }
    };

    const translateRuntimeMessage = (element) => {
      if (!(element instanceof HTMLElement)) return;
      const raw = element.textContent?.trim() || '';
      if (!raw) return;
      const translated = dictionary.statusMap[raw];
      if (translated && translated !== raw) element.textContent = translated;
      if (raw === 'Enviando...') element.textContent = dictionary.sending;
      if (raw === 'Enviar feedback') element.textContent = dictionary.submit;
    };

    const observeRuntimeCopy = () => {
      const status = document.querySelector('[data-feedback-status]');
      const gate = document.querySelector('[data-feedback-gate-note]');
      const submit = document.querySelector('[data-feedback-submit-label]');
      [status, gate, submit].forEach((node) => {
        if (!(node instanceof HTMLElement)) return;
        new MutationObserver(() => translateRuntimeMessage(node)).observe(node, { childList: true, characterData: true, subtree: true });
      });
    };

    const changeLocale = (nextLocale) => {
      if (nextLocale !== 'pt-BR' && nextLocale !== 'en-US' && nextLocale !== 'es-ES') return;
      locale = nextLocale;
      applyStaticCopy();
    };

    applyStaticCopy();
    observeRuntimeCopy();

    window.addEventListener('storage', (event) => {
      if (event.key === LOCALE_KEY) changeLocale(event.newValue);
    });

    window.addEventListener('message', (event) => {
      if (event.origin !== window.location.origin) return;
      if (event.data?.type === 'lab_locale_change') changeLocale(event.data.locale);
    });

    window.__labApplyLocale = changeLocale;
  })();
</script>
