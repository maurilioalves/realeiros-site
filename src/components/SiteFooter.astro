---
import { site } from '../data/site';
import { commonCopy } from '../i18n/common';
import { localizePath, type RouteLocale } from '../i18n/config';

interface Props {
  locale?: RouteLocale;
}

const { locale = 'pt-BR' } = Astro.props;
const year = new Date().getFullYear();
const copy = commonCopy[locale];
const href = (path: string) => localizePath(path, locale);
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <div class="brand brand-footer">
        <img
          class="brand-mark"
          src="/images/brand/logo_circulo.png"
          alt=""
          aria-hidden="true"
        />
        <span class="brand-text"
          ><small>REALEIROS</small><small>PLAY</small></span
        >
      </div>
      <p class="footer-pitch">{site.slogan}</p>
      <p class="footer-muted">{copy.footer.studio}</p>
    </div>

    <div>
      <h2>{copy.footer.explore}</h2>
      <a href={href('/olha-a-batida')}>Olha a Batida</a>
      <a href={href('/sobre')}>{copy.footer.about}</a>
      <a href={href('/press-kit')}>Press Kit</a>
      <a href={href('/novidades')}>{copy.footer.news}</a>
      <a href={href('/contato')}>{copy.footer.contact}</a>
    </div>

    <div>
      <h2>{copy.footer.player}</h2>
      <a href={href('/suporte')}>{copy.footer.support}</a>
      <a href={href('/privacidade')}>{copy.footer.privacy}</a>
      <a href={href('/termos')}>{copy.footer.terms}</a>
      <a href={href('/exclusao-de-dados')}>{copy.footer.deletion}</a>
    </div>

    <div>
      <h2>{copy.footer.social}</h2>
      <a href={site.instagram} target="_blank" rel="noreferrer">Instagram</a>
      <a href={site.tiktok} target="_blank" rel="noreferrer">TikTok</a>
      <a href={site.x} target="_blank" rel="noreferrer">X</a>
      <a href={site.youtube} target="_blank" rel="noreferrer">YouTube</a>
    </div>
    <div>
      <h2>{copy.footer.apps}</h2>
      <a href={site.playStore} target="_blank" rel="noreferrer">Google Play</a>
      <a href={site.appStore} target="_blank" rel="noreferrer">App Store</a>
    </div>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Realeiros Play.</span>
    <span>{copy.footer.identity}</span>
  </div>
</footer>
