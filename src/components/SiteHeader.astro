---
import { site } from '../data/site';
import LocaleSwitcher from './LocaleSwitcher.astro';
import { commonCopy } from '../i18n/common';
import { localizePath, stripLocalePrefix, type RouteLocale } from '../i18n/config';

interface Props {
  locale?: RouteLocale;
  localeSwitcherEnabled?: boolean;
}

const { locale = 'pt-BR', localeSwitcherEnabled = false } = Astro.props;
const pathname = Astro.url.pathname;
const copy = commonCopy[locale];
const links = [
  { href: '/olha-a-batida', label: copy.nav.oab },
  { href: '/lancaabraba', label: copy.nav.lab },
  { href: '/sobre', label: copy.nav.about },
  { href: '/novidades', label: copy.nav.news },
  { href: '/contato', label: copy.nav.contact },
].map((link) => ({ ...link, href: localizePath(link.href, locale) }));
const homeHref = localizePath('/', locale);
const normalizedPath = stripLocalePrefix(pathname).replace(/\/+$/, '') || '/';
const isLabProductPage = normalizedPath === '/lancaabraba';
const labPlayHref = '/lancaabraba/play/';
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={homeHref} aria-label={copy.homeLabel}>
      <img class="brand-mark" src="/images/brand/logo_circulo.png" alt="" aria-hidden="true" />
      <span class="brand-text"><small>REALEIROS</small><small>PLAY</small></span>
    </a>

    <nav class="desktop-nav" aria-label={copy.nav.primary}>
      {
        links.map((link) => (
          <a class:list={[pathname.startsWith(link.href) && 'is-active']} href={link.href}>{link.label}</a>
        ))
      }
      {
        localeSwitcherEnabled && (
          <LocaleSwitcher locale={locale} currentPath={pathname} ariaLabel={copy.nav.language} />
        )
      }
    </nav>

    {
      isLabProductPage ? (
        <a class="button button-small button-primary desktop-cta" href={labPlayHref}>
          {copy.nav.playLab}
        </a>
      ) : (
        <a
          class="button button-small button-primary desktop-cta"
          href={site.playStore}
          target="_blank"
          rel="noreferrer"
          data-oab-store-link
          data-play-store={site.playStore}
          data-app-store={site.appStore}
        >
          {copy.nav.playOab}
        </a>
      )
    }

    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu" data-menu-button>
      <span></span><span></span><span></span>
      <span class="sr-only">{copy.nav.openMenu}</span>
    </button>
  </div>

  <nav id="mobile-menu" class="mobile-nav" aria-label={copy.nav.mobile} data-mobile-nav>
    <div class="container mobile-nav-inner">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
      {
        localeSwitcherEnabled && (
          <LocaleSwitcher locale={locale} currentPath={pathname} ariaLabel={copy.nav.language} />
        )
      }
      {
        isLabProductPage ? (
          <a class="button button-primary" href={labPlayHref}>{copy.nav.playLab}</a>
        ) : (
          <a
            class="button button-primary"
            href={site.playStore}
            target="_blank"
            rel="noreferrer"
            data-oab-store-link
            data-play-store={site.playStore}
            data-app-store={site.appStore}
          >
            {copy.nav.playOab}
          </a>
        )
      }
    </div>
  </nav>
</header>

<script is:inline>
  (() => {
    const ua = navigator.userAgent?.toLowerCase() || '';
    const legacyPlatform = navigator.platform?.toLowerCase() || '';
    const modernPlatform = navigator.userAgentData?.platform?.toLowerCase?.() || '';
    const platform = modernPlatform || legacyPlatform;
    const maxTouchPoints = navigator.maxTouchPoints || 0;

    const isApple =
      /iphone|ipad|ipod|macintosh|mac os x/.test(ua) ||
      /iphone|ipad|ipod|mac/.test(platform) ||
      (platform === 'macintel' && maxTouchPoints > 1);

    document.querySelectorAll('[data-oab-store-link]').forEach((element) => {
      if (!(element instanceof HTMLAnchorElement)) return;
      const playStore = element.dataset.playStore;
      const appStore = element.dataset.appStore;
      const target = isApple ? appStore : playStore;
      if (target) element.href = target;
    });
  })();
</script>
